<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SQL result | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:1000px;margin:30px auto;padding:18px}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;margin:14px 0}a{color:#8fdcff}.muted{color:#9aabc0}.query{white-space:pre-wrap;background:#07101d;padding:12px;border-radius:8px;overflow:auto}</style></head><body><main class="wrap"><a href="/cognizant/history">← Cognizant history</a><h1>Cognizant SQL assessment result</h1><p class="muted"><%= submission.evaluationNote %></p><p><%= submission.solvedTasks %>/<%= submission.totalTasks %> correct · <%= submission.score %>%</p><% submission.tasks.forEach((task,index)=>{ %><section class="panel"><h2>Task <%= index+1 %>: <%= task.title %></h2><p><%= task.message %></p><pre class="query"><%= task.query || 'No query submitted.' %></pre><p class="muted"><%= task.rowsReturned %> rows returned</p><% if (task.explanation) { %><p><strong>Explanation:</strong> <%= task.explanation %></p><% } %></section><% }) %></main></body></html>
