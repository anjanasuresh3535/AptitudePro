<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Aptitude Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- ============================================
     NAVBAR
     ============================================ -->

<nav class="navbar">
    <div class="nav-logo">
        <div class="nav-logo-icon">🧠</div>
        <div class="nav-logo-text">Aptitude<span>Pro</span></div>
    </div>
    <div class="nav-buttons">
        <button type="button" class="btn-nav-fullscreen" id="btnNavFullscreen" title="Toggle Full Screen (or press F)">
            <i class="fa-solid fa-expand"></i> <span>Full Screen</span>
        </button>
        <a href="/login" class="nav-btn-login">Login</a>
        <a href="/register" class="nav-btn-register">Get Started →</a>
    </div>
</nav>

<!-- ============================================
     HERO SECTION
     ============================================ -->

<section class="hero">

    <!-- Badge -->
    <div class="hero-badge">Placement Preparation Platform</div>

    <!-- Title -->
    <h1>Practice Smart.<br><span>Get Placed Faster.</span></h1>

    <!-- Description -->
    <p>Master aptitude, logical reasoning and verbal ability with
    adaptive quizzes, real-time analytics and a gamified learning experience.</p>

    <!-- Buttons -->
    <div class="hero-buttons">
        <a href="/register" class="hero-btn-primary">🎯 Start Practicing Free</a>
        <a href="/login" class="hero-btn-secondary">Login to Account</a>
    </div>

    <!-- Statistics -->
    <div class="stats">
        <div class="stat">
            <strong>500+</strong>
            <span>QUESTIONS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <strong>10+</strong>
            <span>TOPICS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <strong>6</strong>
            <span>BADGES</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
            <strong>∞</strong>
            <span>PRACTICE</span>
        </div>
    </div>

    <!-- Features -->
    <div class="features">
        <div class="feature-card">
            <div class="feature-icon">📝</div>
            <div class="feature-title">Mock Tests</div>
            <div class="feature-desc">Topic wise quizzes</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <div class="feature-title">Analytics</div>
            <div class="feature-desc">Track weak areas</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🎮</div>
            <div class="feature-title">Gamification</div>
            <div class="feature-desc">XP & badges</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🏆</div>
            <div class="feature-title">Leaderboard</div>
            <div class="feature-desc">Rank among peers</div>
        </div>
    </div>

</section>

<!-- ============================================
     FOOTER
     ============================================ -->

<footer class="footer"></footer>

</body>
</html>