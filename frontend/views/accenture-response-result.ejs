<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Response Saved | AptitudePro</title><style>body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.6 Inter,system-ui,sans-serif}.wrap{max-width:850px;margin:40px auto;padding:20px}.panel{background:#101d30;border:1px solid #253650;border-radius:16px;padding:24px}h1{color:white}.response{white-space:pre-wrap;background:#08111f;padding:16px;border-radius:9px}.muted{color:#a9b7ca}.btn{display:inline-block;margin:12px 8px 0 0;padding:10px 15px;border-radius:9px;background:#21a5d8;color:#06111c;text-decoration:none;font-weight:700}</style></head><body><main class="wrap"><section class="panel"><h1>Response saved</h1><p class="muted"><%= submission.taskTitle %> · <%= submission.wordCount %> words · <%= new Date(submission.submittedAt || submission.updatedAt).toLocaleString() %></p><div class="response"><%= submission.responseText %></div><p class="muted">Evaluation will be available when the evaluation service is enabled. No score has been assigned.</p><a class="btn" href="/results/history">Practice history</a><a class="btn" href="/placement/college/company/accenture">Accenture dashboard</a></section></main></body></html>
