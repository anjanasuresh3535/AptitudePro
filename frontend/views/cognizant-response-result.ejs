<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Response saved | AptitudePro</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            margin: 0;
            background: #08111f;
            color: #eaf2ff;
            font: 16px/1.6 Inter, system-ui, sans-serif;
        }
        .wrap {
            max-width: 900px;
            margin: 36px auto;
            padding: 20px;
        }
        .panel {
            background: #101d30;
            border: 1px solid #253650;
            border-radius: 16px;
            padding: 24px;
            margin: 16px 0;
        }
        a {
            color: #8fdcff;
            text-decoration: none;
        }
        a:hover { text-decoration: underline; }
        .muted {
            color: #9aabc0;
            white-space: pre-wrap;
        }
        .audio-result-box {
            background: rgba(0, 242, 254, 0.08);
            border: 1.5px solid rgba(0, 242, 254, 0.3);
            border-radius: 14px;
            padding: 20px;
            margin: 20px 0;
        }
        .audio-result-box audio {
            width: 100%;
            height: 46px;
            outline: none;
            border-radius: 30px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
<main class="wrap">
    <a href="/cognizant/history">← Cognizant history</a>
    <section class="panel">
        <h1><%= submission.submissionStatus === 'submitted' ? 'Response submitted' : 'Draft saved' %></h1>
        <h2><%= submission.taskTitle %></h2>
        <p><%= submission.section %> · <%= submission.wordCount %> words <%= submission.audioDuration ? `· 🎙️ ${submission.audioDuration}s audio recorded` : '' %></p>

        <% if (submission.audioData) { %>
            <div class="audio-result-box">
                <h3 style="margin: 0; color: #00f2fe; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-microphone-lines"></i> Recorded Audio Response
                </h3>
                <audio controls src="<%= submission.audioData %>"></audio>
            </div>
        <% } %>

        <% if (submission.responseText) { %>
            <div class="panel muted">
                <h4 style="margin: 0 0 8px 0; color: #60cfff; font-size: 0.95rem; text-transform: uppercase;">Transcript / Written Response</h4>
                <%= submission.responseText %>
            </div>
        <% } %>

        <p class="muted">Automated evaluation is not enabled; no score was assigned.</p>
        <a href="/placement/college/company/cognizant">Back to Cognizant practice</a>
    </section>
</main>
</body>
</html>
