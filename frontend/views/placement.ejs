                                    <span><i class="fa-solid fa-signal"></i> Mixed difficulty</span>
                                </div>
                                <a href="/quiz?learningPath=college&placementType=company&company=wipro&mode=section&sectionKey=<%= key %>" class="tcs-card-btn" style="background:<%= key === 'quantitativeAptitude' ? 'linear-gradient(135deg,#059669,#34d399)' : (key === 'logicalReasoning' ? 'linear-gradient(135deg,#4f46e5,#818cf8)' : 'linear-gradient(135deg,#b45309,#fbbf24)') %>;">
                                    <i class="fa-solid fa-play"></i> Practice (<%= s.questionCount %> Qs)
                                </a>
                            </div>
                        <% }) %>
                    </div>

                    <!-- CODING SECTION PRACTICE -->
                    <div class="tcs-section-header" style="margin-top:36px;">
                        <div class="tcs-section-badge" style="background:rgba(124,58,237,0.12);color:#c084fc;border-color:rgba(124,58,237,0.25);">
                            <i class="fa-solid fa-code"></i> Component 2 &mdash; Coding Practice
                        </div>
                        <h3>Coding Practice (<%= Math.round(wiproConfig.coding.timeLimitSec / 60) %> Minutes)</h3>
                        <p>Practice coding problems in a dedicated code editor workspace with multiple programming language options.</p>
                    </div>

                    <div class="tcs-cards-grid" style="grid-template-columns: 1fr;">
                        <div class="tcs-practice-card" style="max-width:620px;">
                            <div class="tcs-card-header">
                                <div class="tcs-card-icon" style="background:rgba(124,58,237,0.12);color:#c084fc;"><i class="fa-solid fa-code"></i></div>
                                <div>
                                    <div class="tcs-card-title">Coding Practice</div>
                                    <div class="tcs-card-subtitle"><%= wiproConfig.coding.totalQuestions %> Coding Problems &middot; C / C++ / Java / Python</div>
                                </div>
                            </div>
                            <p class="tcs-card-desc"><%= wiproConfig.coding.description %></p>
                            <div class="tcs-card-meta">
                                <span><i class="fa-regular fa-clock"></i> <%= Math.round(wiproConfig.coding.timeLimitSec / 60) %> minutes</span>
                                <span><i class="fa-solid fa-laptop-code"></i> Multi-language sandbox</span>
                            </div>
                            <a href="/wipro/coding" class="tcs-card-btn" style="background:linear-gradient(135deg,#6d28d9,#a855f7);">
                                <i class="fa-solid fa-play"></i> Start Coding Practice
                            </a>
                        </div>
                    </div>

                    <!-- WRITTEN COMMUNICATION -->

                    <div class="tcs-section-header" style="margin-top:36px;">
                        <div class="tcs-section-badge" style="background:rgba(251,191,36,0.10);color:#fbbf24;border-color:rgba(251,191,36,0.25);">
                            <i class="fa-solid fa-file-pen"></i> Component 3 &mdash; Written Communication
                        </div>
                        <h3>Written Communication (<%= Math.round(wiproConfig.writing.timeLimitSec / 60) %> Minutes)</h3>
                        <p>One essay writing task of 200&ndash;400 words in a dedicated text editor with a live word counter and timer.</p>
                    </div>

                    <div class="tcs-cards-grid" style="grid-template-columns: 1fr;">
                        <div class="tcs-practice-card" style="max-width:620px;">
                            <div class="tcs-card-header">
                                <div class="tcs-card-icon" style="background:rgba(251,191,36,0.12);color:#fbbf24;"><i class="fa-solid fa-file-pen"></i></div>
                                <div>
                                    <div class="tcs-card-title">Written Communication</div>
                                    <div class="tcs-card-subtitle">1 Essay Task &middot; 200&ndash;400 words</div>
                                </div>
                            </div>
                            <p class="tcs-card-desc"><%= wiproConfig.sections.writtenCommunication.description %></p>
                            <div class="tcs-card-meta">
                                <span><i class="fa-regular fa-clock"></i> <%= Math.round(wiproConfig.writing.timeLimitSec / 60) %> minutes</span>
                                <span><i class="fa-solid fa-list-check"></i> Rubric-based self review</span>
                            </div>
                            <a href="/quiz?learningPath=college&placementType=company&company=wipro&mode=mock-writing" class="tcs-card-btn" style="background:linear-gradient(135deg,#92400e,#fbbf24);">
                                <i class="fa-solid fa-play"></i> Start Writing Practice
                            </a>
                        </div>
                    </div>

                    <!-- DISCLAIMER -->
                    <div style="margin-top:32px;padding:14px 18px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;font-size:12px;color:rgba(255,255,255,0.35);line-height:1.7;">
                        <i class="fa-solid fa-circle-info" style="color:#fbbf24;margin-right:6px;"></i>
                        <strong>Pattern Note:</strong> <%= wiproConfig.meta.note %> Reported-pattern reference: <%= wiproConfig.meta.reference %>. This is not an official Wipro document.
                    </div>
                </div>

            <% } else { %>

                <!-- STANDARD 3-LEVEL CARD GRID FOR NON-TCS COMPANIES -->
                <div class="level-grid">
                    <% levels.forEach(function(lvl) { %>
                        <div class="level-card <%= lvl.unlocked ? '' : 'locked' %>">
                            <div>
                                <div class="level-badge <%= lvl.unlocked ? 'unlocked' : 'locked-tag' %>">
                                    <i class="fa-solid <%= lvl.unlocked ? 'fa-lock-open' : 'fa-lock' %>"></i>
                                    <span><%= lvl.unlocked ? 'Unlocked' : 'Locked' %></span>
                                </div>
                                <h3><%= lvl.label.full %></h3>
                                <p><%= lvl.label.tagline %>. 25 placement questions tailored for <%= company.name %> practice pattern at Level <%= lvl.number %>.</p>
                            </div>
                            <% if (lvl.unlocked) { %>
                                <a href="/quiz?learningPath=college&placementType=company&company=<%= company.slug %>&difficulty=<%= lvl.number %>" class="btn-primary">
                                    <span>Start Level <%= lvl.number %> Test</span>
                                    <i class="fa-solid fa-play"></i>
                                </a>
                            <% } else { %>
                                <button class="btn-secondary" disabled>
                                    <span>Score <%= unlockThreshold %>% on Level <%= lvl.number - 1 %> to Unlock</span>
                                </button>
                            <% } %>
                        </div>
                    <% }); %>
                </div>

            <% } %>

        <% } %>

    </div>

    <!-- FLOATING FULLSCREEN QUICK-ACTION BUTTON -->
    <div class="fullscreen-fab-container">
        <button type="button" id="btnFloatingFullscreen" class="btn-floating-fab" title="Toggle Full Screen (or press F)">
            <i class="fa-solid fa-expand" id="floatingFsIcon"></i>
        </button>
    </div>

    <script nonce="<%= cspNonce %>">
        // ── Wide-mode toggle (placement-specific) ────────────────────────────────
        // NOTE: All fullscreen logic is handled globally by /js/fullscreen.js.
        // This script ONLY manages the "Full Width / Compact Width" toggle here.
        (function() {
            var btnToggleWidth = document.getElementById('btnToggleWidth');
            var container      = document.querySelector('.placement-container');

            // Restore wide-mode preference
            if (localStorage.getItem('aptitudepro-wide-mode') === 'true') {
                if (container) container.classList.add('wide-mode');
                if (btnToggleWidth) {
                    btnToggleWidth.classList.add('active');
                    var wText = document.getElementById('widthText');
                    if (wText) wText.textContent = 'Compact Width';
                }
            }

            function toggleWideMode() {
                if (!container) return;
                var isWide = container.classList.toggle('wide-mode');
                localStorage.setItem('aptitudepro-wide-mode', isWide ? 'true' : 'false');
                if (btnToggleWidth) {
                    btnToggleWidth.classList.toggle('active', isWide);
                    var wText = document.getElementById('widthText');
                    if (wText) wText.textContent = isWide ? 'Compact Width' : 'Full Width';
                }
            }

            if (btnToggleWidth) {
                btnToggleWidth.addEventListener('click', function(e) {
                    e.stopPropagation(); // prevent global capture listener from misreading this
                    toggleWideMode();
                });
            }

            // Keep wide-mode class in sync with fullscreen state
            ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange','MSFullscreenChange']
                .forEach(function(ev) {
                    document.addEventListener(ev, function() {
                        var active = !!(document.fullscreenElement ||
                                        document.webkitFullscreenElement ||
                                        document.mozFullScreenElement   ||
                                        document.msFullscreenElement);
                        if (active) {
                            if (container) container.classList.add('wide-mode');
                        } else {
                            if (localStorage.getItem('aptitudepro-wide-mode') !== 'true') {
                                if (container) container.classList.remove('wide-mode');
                            }
                        }
                    });
                });
        })();
    </script>
</body>
</html>
