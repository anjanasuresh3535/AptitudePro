<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof testTitle !== 'undefined' ? testTitle : title %> | AptitudePro</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 (Pro) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0a0e1a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: #e8edf5;
            overflow-x: hidden;
        }

        .navbar {
            background: rgba(10, 14, 26, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            padding: 14px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            position: sticky;
            top: 0;
            z-index: 100;
            transition: all 0.3s ease;
        }

        .navbar .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .navbar .logo i {
            font-size: 28px;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .navbar .logo span {
            font-size: 22px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
        }

        .navbar .logo span.highlight {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .navbar .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .navbar .user-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.06);
            padding: 6px 16px 6px 12px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
        }

        .navbar .user-badge:hover {
            background: rgba(255, 255, 255, 0.10);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .navbar .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: #fff;
        }

        .navbar .user-name {
            font-size: 14px;
            font-weight: 600;
            color: #e8edf5;
        }

        .navbar .user-level {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.06);
            padding: 2px 10px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .navbar .logout-btn {
            color: rgba(255, 255, 255, 0.35);
            font-size: 16px;
            text-decoration: none;
            transition: all 0.3s ease;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .navbar .logout-btn:hover {
            color: #ff6b6b;
            background: rgba(255, 107, 107, 0.10);
            border-color: rgba(255, 107, 107, 0.20);
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 32px 24px 60px;
            flex: 1;
            width: 100%;
        }

        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .quiz-header .title-section h1 {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .quiz-header .title-section .subtitle {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.45);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .quiz-header .title-section .dot-sep {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
        }

        .quiz-header .xp-badge {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px 20px;
        }

        .quiz-header .xp-badge .xp-icon {
            font-size: 24px;
        }

        .quiz-header .xp-badge .level-name {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: rgba(255, 255, 255, 0.4);
        }

        .quiz-header .xp-badge .level-xp {
            font-size: 16px;
            font-weight: 800;
            color: #4facfe;
        }

        .progress-section {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 18px;
            padding: 20px 24px;
            margin-bottom: 28px;
        }

        .progress-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 14px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.5);
        }

        .progress-stats span i {
            margin-right: 6px;
        }

        .progress-dots {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .progress-dots .dot {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.35);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            user-select: none;
        }

        .progress-dots .dot.active {
            border-color: #4facfe;
            background: rgba(79, 172, 254, 0.15);
            color: #4facfe;
            transform: scale(1.10);
            box-shadow: 0 0 20px rgba(79, 172, 254, 0.15);
        }

        .progress-dots .dot.answered {
            border-color: #34d399;
            background: rgba(52, 211, 153, 0.12);
            color: #34d399;
        }

        .progress-dots .dot.skipped {
            border-color: #fbbf24;
            background: rgba(251, 191, 36, 0.12);
            color: #fbbf24;
        }

        .quiz-layout {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 24px;
            align-items: start;
        }

        .quiz-main {
            min-width: 0;
        }

        .quiz-palette {
            position: sticky;
            top: 20px;
            max-height: calc(100vh - 40px);
            overflow-y: auto;
            margin-bottom: 0;
        }

        .quiz-palette .palette-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.35);
            margin-bottom: 12px;
        }

        .quiz-palette .progress-dots {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .quiz-palette .progress-dots .dot {
            width: 100%;
            aspect-ratio: 1 / 1;
            height: auto;
        }
        .quiz-palette .progress-dots .dot.marked-review { outline: 2px solid #fbbf24; outline-offset: 2px; }

        .quiz-palette .palette-legend {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
        }

        .quiz-palette .palette-legend .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .quiz-palette .palette-legend .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .quiz-palette .palette-legend .legend-dot.active { background: #4facfe; }
        .quiz-palette .palette-legend .legend-dot.answered { background: #34d399; }
        .quiz-palette .palette-legend .legend-dot.skipped { background: #fbbf24; }
        .quiz-palette .palette-legend .legend-dot.unanswered { background: rgba(255, 255, 255, 0.15); }

        .question-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 32px 28px;
            margin-bottom: 24px;
            animation: fadeSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            transition: all 0.3s ease;
        }

        @keyframes fadeSlideUp {
            0% { opacity: 0; transform: translateY(20px) scale(0.98); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        .question-card .q-number {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #4facfe;
            margin-bottom: 12px;
        }

        .question-card .q-text {
            font-size: 19px;
            font-weight: 600;
            line-height: 1.6;
            color: #fff;
            margin-bottom: 24px;
        }

        .question-card .q-tag {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.04);
            padding: 3px 10px;
            border-radius: 12px;
            margin-left: 8px;
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .options-grid .option {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: pointer;
            transition: all 0.25s ease;
            user-select: none;
        }

        .options-grid .option:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.12);
            transform: translateX(4px);
        }

        .options-grid .option.selected {
            background: rgba(79, 172, 254, 0.10);
            border-color: #4facfe;
            box-shadow: 0 0 20px rgba(79, 172, 254, 0.15);
        }

        .options-grid .option .option-letter {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.6);
            flex-shrink: 0;
            transition: all 0.25s ease;
        }

        .options-grid .option.selected .option-letter {
            background: #4facfe;
            border-color: #4facfe;
            color: #0a0e1a;
        }

        .options-grid .option .option-text {
            font-size: 15px;
            font-weight: 500;
            color: #d1d5db;
        }

        .options-grid .option.selected .option-text {
            color: #fff;
            font-weight: 600;
        }

        .quiz-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .quiz-actions .btn {
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .quiz-actions .btn-secondary {
            background: rgba(255, 255, 255, 0.06);
            color: #e8edf5;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .quiz-actions .btn-secondary:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.10);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .quiz-actions .btn-secondary:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .quiz-actions .btn-skip {
            background: rgba(251, 191, 36, 0.10);
            color: #fbbf24;
            border: 1px solid rgba(251, 191, 36, 0.15);
        }

        .quiz-actions .btn-skip:hover {
            background: rgba(251, 191, 36, 0.18);
            transform: translateY(-2px);
        }

        .quiz-actions .btn-submit {
            background: linear-gradient(135deg, #34d399, #6ee7b7);
            color: #0a0e1a;
            font-size: 14px;
            padding: 11px 32px;
            box-shadow: 0 4px 20px rgba(52, 211, 153, 0.20);
            margin-left: auto;
        }

        .quiz-actions .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(52, 211, 153, 0.30);
        }

        .error-message {
            background: rgba(248, 113, 113, 0.08);
            border: 1px solid rgba(248, 113, 113, 0.15);
            border-radius: 14px;
            padding: 16px 20px;
            color: #f87171;
            font-size: 14px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .error-message i {
            font-size: 18px;
        }

        .shortcuts-hint {
            margin-top: 20px;
            padding: 14px 20px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: center;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.25);
        }

        .shortcuts-hint kbd {
            display: inline-block;
            padding: 2px 10px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.06);
            font-family: 'Inter', sans-serif;
        }

        @media (max-width: 968px) {
            .quiz-layout {
                grid-template-columns: 1fr;
            }
            .quiz-palette {
                position: static;
                max-height: none;
                order: -1;
            }
            .quiz-palette .progress-dots {
                grid-template-columns: repeat(8, 1fr);
            }
        }

        /* ── Pseudo-code block ───────────────────────────────── */
        .code-block-wrapper {
            margin: 0 0 24px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.10);
        }
        .code-block-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #1a1a2e;
            padding: 8px 16px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
        }
        .code-block-header .lang-badge {
            background: rgba(79,172,254,0.15);
            color: #4facfe;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 10px;
        }
        .code-block-body {
            background: #0d1117;
            overflow-x: auto;
            padding: 0;
        }
        .code-block-body table {
            border-collapse: collapse;
            width: 100%;
            min-width: max-content;
        }
        .code-block-body td {
            padding: 0;
            vertical-align: top;
        }
        .code-block-body .line-nums {
            user-select: none;
            text-align: right;
            padding: 16px 12px 16px 16px;
            color: rgba(255,255,255,0.2);
            font-family: 'Courier New', Consolas, monospace;
            font-size: 13px;
            line-height: 1.7;
            border-right: 1px solid rgba(255,255,255,0.06);
            background: #0d1117;
            white-space: pre;
            min-width: 40px;
        }
        .code-block-body .line-code {
            padding: 16px 20px;
            font-family: 'Courier New', Consolas, monospace;
            font-size: 13px;
            line-height: 1.7;
            color: #e6edf3;
            white-space: pre;
            background: #0d1117;
        }
        /* basic syntax colours */
        .code-block-body .kw  { color: #ff7b72; }  /* keywords */
        .code-block-body .fn  { color: #d2a8ff; }  /* function names */
        .code-block-body .cm  { color: #8b949e; font-style: italic; }  /* comments */
        .code-block-body .st  { color: #a5d6ff; }  /* strings */
        .code-block-body .nm  { color: #79c0ff; }  /* numbers */
        .code-block-body .pp  { color: #ffa657; }  /* preprocessor */

        /* ── English Writing textarea ────────────────────────── */
        .writing-prompt-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #fbbf24;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .writing-textarea {
            width: 100%;
            min-height: 220px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.10);
            border-radius: 12px;
            padding: 16px 18px;
            color: #e8edf5;
            font-size: 15px;
            font-family: inherit;
            line-height: 1.7;
            resize: vertical;
            transition: border-color 0.25s ease;
            box-sizing: border-box;
        }
        .writing-textarea:focus {
            outline: none;
            border-color: #4facfe;
            background: rgba(79,172,254,0.04);
        }
        .writing-word-counter {
            margin-top: 8px;
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .writing-word-counter .wc-count { font-weight: 700; color: #4facfe; }
        .writing-word-counter .wc-warn  { color: #f87171; }
        .writing-word-counter .wc-ok    { color: #34d399; }
        .writing-rubric {
            margin-top: 16px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            padding: 12px 16px;
        }
        .writing-rubric-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: rgba(255,255,255,0.35);
            margin-bottom: 8px;
        }
        .writing-rubric ul {
            margin: 0;
            padding-left: 18px;
            font-size: 12px;
            color: rgba(255,255,255,0.4);
            line-height: 1.8;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/dashboard" class="logo">
            <i class="fas fa-brain"></i>
            <span>Aptitude<span class="highlight">Pro</span></span>
        </a>
        <div class="nav-right">
            <button type="button" class="btn-nav-fullscreen" id="btnNavFullscreen" title="Toggle Full Screen (or press F)" style="margin-right: 8px;">
                <i class="fa-solid fa-expand"></i> <span>Full Screen</span>
            </button>
            <div class="user-badge">
                <div class="user-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'G' %></div>
                <span class="user-name"><%= user ? user.name : 'Guest' %></span>
                <span class="user-level">Lv <%= levelNum || 1 %></span>
            </div>
            <a href="/logout" class="logout-btn" title="Logout">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </nav>

    <div class="container">

        <div class="quiz-header">
            <div class="title-section">
                <h1><%= typeof testTitle !== 'undefined' ? testTitle : (section || 'Quiz') %></h1>
                <div class="subtitle">
                    <span><%= typeof difficultyLabel !== 'undefined' && difficultyLabel ? difficultyLabel.full : 'Level 1' %></span>
                    <span class="dot-sep"></span>
                    <span id="questionCounter">1</span> / <span><%= totalQ || 0 %></span>
                    <span class="dot-sep"></span>
                    <span><i class="far fa-clock"></i> <span id="timerDisplay">00:00</span></span>
                </div>
            </div>
            <div class="xp-badge">
                <span class="xp-icon"><%= levelInfo ? levelInfo.icon : '🌟' %></span>
                <div class="xp-info">
                    <div class="level-name"><%= levelData ? levelData.tier : 'Bronze' %></div>
                    <div class="level-xp"><i class="fas fa-bolt"></i> <%= xp || 0 %> XP</div>
                </div>
            </div>
        </div>

        <% if (typeof noticeMessage !== 'undefined' && noticeMessage) { %>
            <div class="error-message" style="background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.3); color: #93c5fd;">
                <i class="fas fa-info-circle"></i>
                <span><%= noticeMessage %></span>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="error-message">
                <i class="fas fa-exclamation-circle"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <div class="quiz-layout">

            <div class="quiz-main">
                <form id="quizForm" action="/quiz/submit-quiz" method="POST"
                      data-total-questions="<%= totalQ || 0 %>"
                      data-xp-per="<%= xpPer || 10 %>"
                      data-penalty="<%= penalty || 5 %>"
                      data-skip-penalty="<%= skipPenalty || 2 %>"
                      data-negative-marking="<%= typeof negativeMarking === 'undefined' || negativeMarking ? 'true' : 'false' %>"
                      data-remaining-seconds="<%= typeof remainingSeconds !== 'undefined' ? remainingSeconds : 1800 %>"
                      data-time-limit="<%= typeof timeLimitSec !== 'undefined' ? timeLimitSec : 1800 %>"
                      data-question-ids='<%- JSON.stringify(questions ? questions.map(function(q){ return q.qid; }) : []) %>'>

                    <input type="hidden" name="section" value="<%= section %>">
                    <input type="hidden" name="learningPath" value="<%= typeof learningPath !== 'undefined' ? learningPath : 'college' %>">
                    <input type="hidden" name="placementType" value="<%= typeof placementType !== 'undefined' ? placementType : 'general' %>">
                    <input type="hidden" name="company" value="<%= typeof company !== 'undefined' ? company : '' %>">
                    <input type="hidden" name="testTitle" value="<%= typeof testTitle !== 'undefined' ? testTitle : '' %>">
                    <input type="hidden" name="totalQuestions" value="<%= totalQ %>">
                    <input type="hidden" name="correctAnswers" id="correctAnswers" value="0">
                    <input type="hidden" name="wrongAnswers" id="wrongAnswers" value="0">
                    <input type="hidden" name="xpEarned" id="xpEarned" value="0">
                    <input type="hidden" name="xpLost" id="xpLost" value="0">
                    <input type="hidden" name="questionIds" id="questionIds" value="">
                    <input type="hidden" name="selectedOptions" id="selectedOptions" value="">
                    <input type="hidden" name="isCorrect" id="isCorrect" value="">
                    <input type="hidden" name="timeTaken" id="timeTaken" value="0">
                    <input type="hidden" name="essayTexts" id="essayTexts" value="[]">

                    <div id="questionContainer">
                        <% if (questions && questions.length > 0) { %>
                            <% questions.forEach(function(q, index) { %>
                                <%
                                // ── Server-side helpers ─────────────────────────
                                // Parse optional word-count range from writing prompt
                                var wcMin = 0, wcMax = 0;
                                if (q.isWriting) {
                                    var wcMatch = q.question_text.match(/\b(\d{2,4})[–\-]\s*(\d{2,4})\s*words?\b/i);
                                    if (!wcMatch) wcMatch = q.question_text.match(/\b(\d{2,4})\s*(?:to|–|\-)\s*(\d{2,4})\s*words?\b/i);
                                    if (wcMatch) { wcMin = parseInt(wcMatch[1]); wcMax = parseInt(wcMatch[2]); }
                                }

                                // ── Simple syntax highlighter for C/pseudo-code ──
                                function highlightLine(line) {
                                    var h = line
                                        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                                    // preprocessor directives
                                    h = h.replace(/^(\s*)(#\w+)/, '$1<span class="pp">$2</span>');
                                    // line comments
                                    h = h.replace(/(\/\/[^\n]*)/, '<span class="cm">$1</span>');
                                    // block comments (single-line only here)
                                    h = h.replace(/(\/\*.*?\*\/)/, '<span class="cm">$1</span>');
                                    // string literals
                                    h = h.replace(/("(?:[^"\\]|\\.)*")/, '<span class="st">$1</span>');
                                    // C keywords
                                    h = h.replace(/\b(int|char|float|double|void|return|if|else|for|while|do|switch|case|break|continue|struct|typedef|include|printf|scanf|main|static|const|long|short|unsigned|signed|NULL|true|false|auto|register|extern|goto|enum|union|sizeof|default)\b/g, '<span class="kw">$1</span>');
                                    // numbers (after keywords to avoid matching inside words)
                                    h = h.replace(/\b(\d+(?:\.\d+)?)\b/g, '<span class="nm">$1</span>');
                                    return h;
                                }

                                // Build line-number column and highlighted code column
                                var codeLines = [];
                                if (q.isPseudoCode) {
                                    // question_text may have a descriptive part followed by code
                                    // Try to split on the first blank line after any intro sentence
                                    var raw = q.question_text || '';
                                    // Normalize \n literals written as backslash-n in JSON strings
                                    raw = raw.replace(/\\n/g, '\n');
                                    codeLines = raw.split('\n');
                                }
                                %>
                                <div class="question-card" data-index="<%= index %>"
                                     data-qtype="<%= q.isWriting ? 'writing' : (q.isPseudoCode ? 'pseudocode' : 'mcq') %>"
                                     style="display: <%= index === 0 ? 'block' : 'none' %>;">

                                    <div class="q-number">Question <%= index + 1 %> of <%= totalQ %></div>

                                    <% if (q.isPseudoCode) { %>
                                        <%/* Pseudo-code: show question stem + code block */%>
                                        <div class="q-text" style="margin-bottom: 16px;">
                                            What is the output of the following program?
                                            <span class="q-tag"><%= q.category || 'Pseudo Code' %></span>
                                        </div>
                                        <div class="code-block-wrapper">
                                            <div class="code-block-header">
                                                <span>C Program</span>
                                                <span class="lang-badge">C</span>
                                            </div>
                                            <div class="code-block-body">
                                                <table><tr>
                                                    <td class="line-nums"><% for(var ln=1;ln<=codeLines.length;ln++){%><%= ln %><% if(ln<codeLines.length){%>
<%}%><% } %></td>
                                                    <td class="line-code"><%- codeLines.map(function(l){ return highlightLine(l); }).join('\n') %></td>
                                                </tr></table>
                                            </div>
                                        </div>
                                        <div class="options-grid">
                                            <div class="option" data-value="A">
                                                <span class="option-letter">A</span>
                                                <span class="option-text"><%= q.option_a %></span>
                                            </div>
                                            <div class="option" data-value="B">
                                                <span class="option-letter">B</span>
                                                <span class="option-text"><%= q.option_b %></span>
                                            </div>
                                            <div class="option" data-value="C">
                                                <span class="option-letter">C</span>
                                                <span class="option-text"><%= q.option_c %></span>
                                            </div>
                                            <div class="option" data-value="D">
                                                <span class="option-letter">D</span>
                                                <span class="option-text"><%= q.option_d %></span>
                                            </div>
                                        </div>

                                    <% } else if (q.isWriting) { %>
                                        <%/* English Writing: show prompt + textarea */%>
                                        <div class="writing-prompt-label">
                                            <i class="fas fa-pen-alt"></i> Writing Task
                                        </div>
                                        <div class="q-text" style="margin-bottom: 20px;">
                                            <%- q.question_text.replace(/\n/g,'<br>') %>
                                            <span class="q-tag"><%= q.category || 'English Writing' %></span>
                                        </div>
                                        <div style="margin-bottom: 4px; font-size: 13px; color: rgba(255,255,255,0.5);">Your Answer</div>
                                        <textarea class="writing-textarea"
                                                  data-index="<%= index %>"
                                                  data-wc-min="<%= wcMin %>"
                                                  data-wc-max="<%= wcMax %>"
                                                  placeholder="Start writing your response here…"
                                                  rows="10"></textarea>
                                        <div class="writing-word-counter">
                                            <span>Word count: <span class="wc-count" id="wc_<%= index %>">0</span></span>
                                            <% if (wcMin > 0 && wcMax > 0) { %>
                                                <span>/ <%= wcMin %>–<%= wcMax %> words</span>
                                            <% } %>
                                            <span class="wc-status" id="wcs_<%= index %>"></span>
                                        </div>
                                        <div class="writing-rubric">
                                            <div class="writing-rubric-title"><i class="fas fa-list-check"></i> Evaluation Criteria (review only - not answer options)</div>
                                            <ul>
                                                <li>Relevance to the topic</li>
                                                <li>Grammar</li>
                                                <li>Vocabulary</li>
                                                <li>Clarity</li>
                                                <li>Coherence</li>
                                                <li>Paragraph structure</li>
                                                <li>Appropriate conclusion</li>
                                            </ul>
                                        </div>

                                    <% } else { %>
                                        <%/* Standard MCQ */%>
                                        <div class="q-text">
                                            <%= q.question_text %>
                                            <span class="q-tag"><%= q.category || 'General' %></span>
                                        </div>
                                        <div class="options-grid">
                                            <div class="option" data-value="A">
                                                <span class="option-letter">A</span>
                                                <span class="option-text"><%= q.option_a %></span>
                                            </div>
                                            <div class="option" data-value="B">
                                                <span class="option-letter">B</span>
                                                <span class="option-text"><%= q.option_b %></span>
                                            </div>
                                            <div class="option" data-value="C">
                                                <span class="option-letter">C</span>
                                                <span class="option-text"><%= q.option_c %></span>
                                            </div>
                                            <div class="option" data-value="D">
                                                <span class="option-letter">D</span>
                                                <span class="option-text"><%= q.option_d %></span>
                                            </div>
                                        </div>
                                    <% } %>

                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="error-message">
                                <i class="fas fa-info-circle"></i>
                                <span>No questions available for this level. Please choose another level.</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="quiz-actions">
                        <button type="button" class="btn btn-secondary" id="prevBtn" disabled>
                            <i class="fas fa-arrow-left"></i> Previous
                        </button>
                        <button type="button" class="btn btn-secondary" id="nextBtn">
                            Next <i class="fas fa-arrow-right"></i>
                        </button>
                        <button type="button" class="btn btn-skip" id="skipBtn">
                            <i class="fas fa-forward"></i> Skip
                        </button>
                        <button type="submit" class="btn btn-submit" id="submitBtn">
                            <i class="fas fa-check"></i> Submit Quiz
                        </button>
                    </div>

                </form>

                <div class="shortcuts-hint">
                    <span><kbd>←</kbd> <kbd>→</kbd> Navigate</span>
                    <span class="sep">|</span>
                    <span><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> <kbd>4</kbd> Select options</span>
                    <span class="sep">|</span>
                    <span><kbd>S</kbd> Skip question</span>
                </div>
            </div>

            <aside class="progress-section quiz-palette">
                <div class="palette-title"><i class="fas fa-th"></i> Question Palette</div>
                <div class="progress-stats">
                    <span class="stat-answered"><i class="fas fa-check-circle"></i> <span id="answeredCount">0</span> answered</span>
                    <span class="stat-skipped"><i class="fas fa-forward"></i> <span id="skippedCount">0</span> skipped</span>
                </div>
                <% if (company === 'HCLTech' || company === 'IBM') { %><button type="button" id="markReviewBtn" class="btn-secondary" aria-pressed="false">Mark for review</button><p class="muted">No negative marking in this practice configuration.</p><% } %>
                <div class="progress-dots" id="progressDots">
                    <% for(var i = 0; i < totalQ; i++) { %>
                        <div class="dot" data-index="<%= i %>"><%= i + 1 %></div>
                    <% } %>
                </div>
                <div class="palette-legend">
                    <span class="legend-item"><span class="legend-dot active"></span> Current question</span>
                    <span class="legend-item"><span class="legend-dot answered"></span> Answered</span>
                    <span class="legend-item"><span class="legend-dot skipped"></span> Skipped</span>
                    <span class="legend-item"><span class="legend-dot unanswered"></span> Unanswered</span>
                    <% if (company === 'HCLTech' || company === 'IBM') { %><span class="legend-item"><span class="legend-dot" style="background:#fbbf24"></span> Marked for review</span><% } %>
                </div>
            </aside>

        </div>

    </div>

    <script src="/js/quiz.js"></script>

</body>
</html>
