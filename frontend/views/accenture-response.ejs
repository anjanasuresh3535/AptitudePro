<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | AptitudePro</title><style>
*{box-sizing:border-box}body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:900px;margin:auto;padding:28px 18px}.back{color:#8fdcff;text-decoration:none}.panel{background:#101d30;border:1px solid #253650;border-radius:16px;padding:24px;margin-top:18px}h1,h2{color:white}.eyebrow{color:#60cfff;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem}.timer{float:right;color:#fbbf24;font-weight:800;font-variant-numeric:tabular-nums}.prompt{white-space:pre-wrap;font-size:1.05rem}.task-meta{color:#a9b7ca}.label{display:block;font-weight:700;margin:22px 0 8px}textarea{width:100%;min-height:300px;resize:vertical;background:#08111f;color:#f4f8ff;border:1px solid #354963;border-radius:10px;padding:15px;font:15px/1.6 Inter,system-ui,sans-serif}textarea:focus{outline:2px solid #36b6e8;border-color:transparent}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}.btn{border:0;border-radius:9px;padding:11px 17px;font-weight:700;cursor:pointer;background:#21a5d8;color:#06111c}.btn.secondary{background:#253650;color:#eaf2ff}.status{min-height:28px;color:#9edcff}.criteria{color:#adbacb}.criteria li{margin:5px 0}.muted{color:#92a1b5;font-size:.9rem}@media(max-width:560px){.wrap{padding:18px 12px}.panel{padding:17px}textarea{min-height:250px}}
</style></head><body><main class="wrap"><a class="back" href="<%= section === 'Communication' ? '/accenture/communication' : '/accenture/interview' %>">← Back</a><section class="panel"><% if (unavailable) { %><h1>No task is available right now</h1><p class="muted">There are no active tasks in this practice pool yet.</p><% } else { %><div class="eyebrow"><span class="timer" id="timer" data-seconds="<%= remainingSeconds %>">--:--</span><%= section %></div><h1><%= task.question %></h1><p class="task-meta"><%= task.topic || '' %> · <%= task.difficulty || 'Medium' %><% if (task.minWords || task.maxWords) { %> · <%= task.minWords || 0 %>–<%= task.maxWords || 'any' %> words<% } %></p><p class="prompt"><%= task.prompt || task.question %></p><label class="label" for="response">YOUR RESPONSE</label><textarea id="response" maxlength="20000" placeholder="Write your response here…"><%= draftText || '' %></textarea><p class="muted"><span id="wordCount">0</span> words<% if (task.minWords || task.maxWords) { %> · Suggested length: <%= task.minWords || 0 %>–<%= task.maxWords || 'any' %> words<% } %></p><% if (task.evaluationCriteria && task.evaluationCriteria.length) { %><div class="criteria"><strong>Review checklist</strong><ul><% task.evaluationCriteria.forEach(item => { %><li><%= item %></li><% }); %></ul></div><% } %><div class="actions"><button class="btn secondary" id="saveDraft">Save Draft</button><button class="btn" id="submitResponse">Submit Response</button></div><p class="status" id="status" role="status"></p><p class="muted">Your response is stored privately. Automated scoring is not enabled, so no score will be assigned.</p><script>
const area=document.getElementById('response'), count=document.getElementById('wordCount'), statusNode=document.getElementById('status'); const key='acc-response-<%= attemptId %>'; const saved=localStorage.getItem(key); if(saved!==null) area.value=saved; function words(){return area.value.trim()?area.value.trim().split(/\s+/).length:0} area.addEventListener('input',()=>{count.textContent=words();localStorage.setItem(key,area.value)}); count.textContent=words(); async function save(submit){statusNode.textContent='Saving…';try{const r=await fetch('/accenture/response/draft',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId:'<%= attemptId %>',responseText:area.value,submit:String(submit)})});const data=await r.json();if(!r.ok||!data.ok)throw new Error(data.message||'Could not save.'); if(submit){localStorage.removeItem(key); location.href='/accenture/submission/'+data.id; return} statusNode.textContent=data.message}catch(e){statusNode.textContent=e.message}}document.getElementById('saveDraft').addEventListener('click',()=>save(false));document.getElementById('submitResponse').addEventListener('click',()=>save(true));const timer=document.getElementById('timer');let remaining=Number(timer?.dataset.seconds)||0;function tick(){if(!timer)return;timer.textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0');if(remaining<=0){timer.textContent='Time ended';return}remaining--}tick();setInterval(tick,1000);
</script><% } %></section></main></body></html>
