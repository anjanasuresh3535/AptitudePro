<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Practice Review · AptitudePro</title><style>body{margin:0;background:#08101c;color:#edf5ff;font:16px/1.55 system-ui,sans-serif}.wrap{max-width:950px;margin:32px auto;padding:16px}.card{background:#121e30;border:1px solid #2b3b52;border-radius:14px;padding:22px;margin:14px 0}.muted{color:#a7bad1}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#091321;border-radius:9px;padding:14px}.btn{display:inline-block;background:#35b9e8;color:#061522;text-decoration:none;padding:11px 16px;border-radius:9px;font-weight:700;margin:4px}</style></head><body><main class="wrap"><section class="card"><h1><%= attempt.sectionKey %> practice review</h1><p class="muted">Saved responses · No subjective score was generated.</p><p><%= Math.floor((attempt.timeTaken||0)/60) %> minutes practiced</p></section><% (attempt.responses||[]).forEach((item,i)=>{ %><article class="card"><h2><%= item.prompt || item.promptId %></h2><pre><%= item.response || '(No response entered)' %></pre><% if(item.expectedAnswer){ %><h3>Suggested answer structure</h3><p><%= item.expectedAnswer %></p><% } %><% if(item.explanation){ %><p class="muted"><%= item.explanation %></p><% } %></article><% }); %><section class="card"><h2>Self-review</h2><p>Review relevance, organization, clarity, supporting examples, professionalism, and a clear conclusion. Practice notes are not an official employer score.</p><a class="btn" href="/placement/college/company/ibm">IBM practice</a><a class="btn" href="/ibm/history">History</a></section></main></body></html>
