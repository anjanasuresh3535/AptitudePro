<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · AptitudePro</title><link rel="stylesheet" href="/css/tech-mahindra.css"><style>.topic-tools{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:18px 0}.topic-card{display:none}.topic-card.active{display:block}.points{display:grid;grid-template-columns:1fr 1fr;gap:14px}.points section,.guidance{background:#0b1727;border:1px solid #293b54;border-radius:10px;padding:14px}.points li{margin:.5em 0}.checklist label{display:block;margin:8px 0}@media(max-width:640px){.points{grid-template-columns:1fr}}</style></head><body><header class="top"><a href="/placement/college/company/ibm">← IBM practice</a><strong><%= title %></strong><span class="timer" id="timer" data-seconds="<%= remainingSeconds %>"></span></header><main class="wrap"><section class="card"><h1><%= title %></h1><p class="muted">Original AptitudePro placement practice; hiring formats and requirements vary by role and drive.</p>
<form id="activityForm"><input type="hidden" id="attemptId" value="<%= attemptId %>">
<% if (kind === 'groupDiscussion') { const saved=Object.fromEntries((savedResponses||[]).map(r=>[r.promptId,r.response])); const categories=[...new Set(items.map(x=>x.category))]; %>
<p class="notice">Optional individual practice. This does not simulate other participants or automatically score your response. Choose a topic category, review both perspectives, then draft a short opening or conclusion.</p>
<div class="topic-tools"><label for="topicCategory">Topic category</label><select id="topicCategory"><% categories.forEach(category=>{ %><option value="<%= category %>"><%= category %></option><% }); %></select><label for="topicChoice">Practice topic</label><select id="topicChoice"><% items.forEach((item,i)=>{ %><option value="<%= item.id %>" data-category="<%= item.category %>" <%= i===0?'selected':'' %>><%= item.title %></option><% }); %></select></div>
<% items.forEach((item,i)=>{ %><article class="item topic-card <%= i===0?'active':'' %>" data-topic="<%= item.id %>" data-category="<%= item.category %>"><p class="muted"><%= item.category %></p><h2><%= item.title %></h2><p><%= item.description %></p><div class="guidance"><strong>Preparation</strong><p><%= item.preparation %></p><p><strong>Opening:</strong> define the topic and state a balanced position. <strong>Counterargument:</strong> acknowledge a reasonable opposing concern and respond respectfully. <strong>Conclusion:</strong> summarize your main point and a practical next step.</p><p><strong>Example:</strong> <%= item.example %></p></div><div class="points"><section><h3>Supporting points</h3><ul><% item.support.forEach(point=>{ %><li><%= point %></li><% }); %></ul></section><section><h3>Opposing considerations</h3><ul><% item.oppose.forEach(point=>{ %><li><%= point %></li><% }); %></ul></section></div><label for="response-<%= item.id %>">Your notes or speaking response</label><textarea class="response" id="response-<%= item.id %>" data-id="<%= item.id %>" maxlength="20000" placeholder="Write your opening, supporting example, response to another view, and conclusion"><%= saved[item.id]||'' %></textarea></article><% }); %>
<div class="checklist"><h2>Self-evaluation</h2><% ['Relevant to the topic','Organized opening, points, and conclusion','Clear and concise delivery','Supported by an example','Respectful treatment of other views'].forEach(x=>{ %><label><input type="checkbox" class="self-review" value="<%= x %>" <%= (saved['self-review']||'').split('; ').includes(x)?'checked':'' %>> <%= x %></label><% }); %></div>
<% } else { const saved=Object.fromEntries((savedResponses||[]).map(r=>[r.promptId,r.response])); items.forEach(item=>{ %><article class="item"><p class="muted"><%= item.category %> · <%= item.difficulty || '' %></p><h2><%= item.question || item.prompt %></h2><label for="response-<%= item.id %>">Your answer</label><textarea class="response" id="response-<%= item.id %>" data-id="<%= item.id %>" maxlength="20000" placeholder="Draft your response"><%= saved[item.id]||'' %></textarea><button class="btn secondary reveal" type="button">Reveal suggested answer structure</button><div class="answer"><%= item.answer || item.example %></div></article><% }); if(kind==='hrInterview'){ %><div class="checklist"><h2>Self-review</h2><% ['Relevant to the question','Clear and concise','Supported by a truthful example','Professional tone','Accurate to my experience'].forEach(x=>{ %><label><input type="checkbox" class="self-review" value="<%= x %>" <%= (saved['self-review']||'').split('; ').includes(x)?'checked':'' %>> <%= x %></label><% }); %></div><% } } %>
<div class="actions"><button class="btn secondary" id="save" type="button">Save draft</button><button class="btn" id="submit" type="button">Finish and save for review</button></div><div class="status" id="status" role="status" aria-live="polite"></div></form></section></main>
<script nonce="<%= cspNonce %>">(()=>{const kind=<%- JSON.stringify(kind) %>,attempt=document.getElementById('attemptId').value,status=document.getElementById('status');let pending,saving=false,submitAgain=false;function responseData(){const data={};document.querySelectorAll('.response').forEach(el=>data[el.dataset.id]=el.value);if(['groupDiscussion','hrInterview'].includes(kind))data.__selfReview=[...document.querySelectorAll('.self-review:checked')].map(el=>el.value);return data}async function save(submit){if(saving){if(submit)submitAgain=true;return}clearTimeout(pending);saving=true;status.textContent=submit?'Saving…':'Saving draft…';try{const r=await fetch('/ibm/activity/'+kind+'/'+(submit?'submit':'draft'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId:attempt,responses:responseData()})}),body=await r.json();if(!r.ok||!body.ok)throw Error(body.message||'Could not save');if(submit)location.href=body.redirect;else status.textContent='Draft saved'}catch(e){status.textContent=e.message}finally{saving=false;if(submitAgain){submitAgain=false;save(true)}}}document.getElementById('save').onclick=()=>save(false);document.getElementById('submit').onclick=()=>save(true);document.querySelectorAll('.response,.self-review').forEach(el=>el.addEventListener('input',()=>{clearTimeout(pending);pending=setTimeout(()=>save(false),800)}));document.querySelectorAll('.self-review').forEach(el=>el.addEventListener('change',()=>{clearTimeout(pending);pending=setTimeout(()=>save(false),200)}));document.querySelectorAll('.reveal').forEach(btn=>btn.onclick=()=>{const answer=btn.nextElementSibling;answer.classList.toggle('visible');btn.textContent=answer.classList.contains('visible')?'Hide suggested answer':'Reveal suggested answer structure'});if(kind==='groupDiscussion'){const category=document.getElementById('topicCategory'),choice=document.getElementById('topicChoice'),cards=[...document.querySelectorAll('.topic-card')];function updateTopics(){const valid=[...choice.options].filter(o=>o.dataset.category===category.value);[...choice.options].forEach(o=>o.hidden=o.dataset.category!==category.value);if(!valid.some(o=>o.value===choice.value))choice.value=valid[0]?.value||'';cards.forEach(card=>card.classList.toggle('active',card.dataset.topic===choice.value))}category.onchange=updateTopics;choice.onchange=updateTopics;updateTopics()}const timer=document.getElementById('timer');let seconds=Number(timer.dataset.seconds)||0;if(seconds){function tick(){timer.textContent=Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0');if(seconds--<=0){clearInterval(interval);save(true)}}tick();const interval=setInterval(tick,1000)}else timer.textContent='Untimed practice'})();</script></body></html>
