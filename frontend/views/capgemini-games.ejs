<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capgemini Cognitive Games | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>
*{box-sizing:border-box}body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:950px;margin:auto;padding:22px}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;margin:14px 0}.muted{color:#9aabc0}.timer{color:#fbbf24;font-weight:800}.input{background:#08111f;color:white;border:1px solid #354963;border-radius:8px;padding:10px;font-size:1rem}.btn{border:0;border-radius:9px;padding:11px 16px;background:#1da8d8;color:#08111f;font-weight:700;cursor:pointer}.row{display:flex;gap:14px;flex-wrap:wrap}.status{color:#9edcff}.choices label{display:inline-flex;gap:6px;margin:8px 14px 8px 0}#digitSequence{font-size:2rem;letter-spacing:.25em;font-weight:800}
</style></head><body><main class="wrap"><a href="/placement/college/company/capgemini">← Capgemini practice</a><div class="row"><h1 style="flex:1">Cognitive practice games</h1><strong id="timer" class="timer" data-seconds="<%= remainingSeconds %>">--:--</strong></div><p class="muted">Four original AptitudePro practice games. Progress: 4 activities. Scores reflect only the answer checks described here, not a hiring or psychometric assessment.</p>
<section class="panel"><h2>Progress</h2><progress id="progress" value="0" max="4" style="width:100%"></progress><span id="progressText" class="muted">0 of 4 games attempted</span></section>
<section class="panel game"><h2>1. Motion and sequence</h2><p><%= challenge.motion %></p><div class="choices" role="group" aria-label="Choose the next direction"><% ['↑','→','↓','←'].forEach((arrow,i)=>{ %><label><input type="radio" name="motion" value="<%= arrow %>"> <%= arrow %></label><% }) %></div></section>
<section class="panel game"><h2>2. Digit memory</h2><p>Memorize the sequence. It will disappear after 7 seconds, then enter it below.</p><div id="digitSequence"><%= challenge.digits %></div><label for="digits">Your sequence</label> <input class="input" id="digits" inputmode="numeric" autocomplete="off"></section>
<section class="panel game"><h2>3. Switch logic</h2><p><%= challenge.switches %></p><div class="choices"><% ['A','B','C','D'].forEach(letter=>{ %><label><input type="checkbox" name="switches" value="<%= letter.toLowerCase() %>"> Switch <%= letter %> ON</label><% }) %></div></section>
<section class="panel game"><h2>4. Deductive reasoning</h2><p><%= challenge.deduction %></p><div class="row"><% ['Ada','Bert','Cleo'].forEach(person=>{ %><label><%= person %> <select class="input" id="pet-<%= person.toLowerCase() %>"><option value="">Choose pet</option><% ['cat','dog','bird'].forEach(pet=>{ %><option value="<%= pet %>"><%= pet %></option><% }) %></select></label><% }) %></div></section>
<div class="row"><button id="submit" class="btn">Finish and review</button><a class="btn" href="/capgemini/games/restart">Restart games</a></div><p id="status" class="status" role="status"></p><section id="summary" class="panel" hidden></section>
<script nonce="<%= cspNonce %>">
const attemptId='<%= attemptId %>';
const digitSequence=document.getElementById('digitSequence');
setTimeout(()=>{digitSequence.textContent='••••••'},7000);
function updateProgress(){const done=[!!document.querySelector('input[name="motion"]:checked'),!!document.getElementById('digits').value.trim(),document.querySelectorAll('input[name="switches"]:checked').length>0,['ada','bert','cleo'].every(p=>!!document.getElementById('pet-'+p).value)].filter(Boolean).length;document.getElementById('progress').value=done;document.getElementById('progressText').textContent=`${done} of 4 games attempted`;}
document.querySelectorAll('.game input,.game select').forEach(control=>control.addEventListener('input',updateProgress));
let seconds=Number(document.getElementById('timer').dataset.seconds)||0;
function tick(){document.getElementById('timer').textContent=seconds<=0?'Time ended':String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');if(seconds>0)seconds--}tick();setInterval(tick,1000);
document.getElementById('submit').addEventListener('click',async()=>{
 const motion=document.querySelector('input[name="motion"]:checked')?.value||'';
 const switches=[...document.querySelectorAll('input[name="switches"]:checked')].map(x=>x.value).sort().join(',');
 const deduction=['ada','bert','cleo'].map(p=>p+':'+document.getElementById('pet-'+p).value).join(',');
 const status=document.getElementById('status');status.textContent='Saving review…';
 try{const response=await fetch('/capgemini/games/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId,answers:{motion,digits:document.getElementById('digits').value,switches,deduction}})});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.message||'Could not save results.');
 status.textContent='';const box=document.getElementById('summary');box.hidden=false;box.replaceChildren();const h=document.createElement('h2');h.textContent=`Practice summary: ${data.score}/${data.total} correct`;box.append(h);const ul=document.createElement('ul');data.responses.forEach(item=>{const li=document.createElement('li');li.textContent=`${item.promptId}: ${item.correct?'Correct':'Review'} · Your answer: ${item.response||'No answer'} · Correct: ${item.expectedAnswer}. ${item.explanation}`;ul.append(li)});box.append(ul);const link=document.createElement('a');link.href='/capgemini/result/'+data.id;link.textContent='Open saved review';box.append(link);document.getElementById('submit').disabled=true;
 }catch(error){status.textContent=error.message}
});
</script></main></body></html>
