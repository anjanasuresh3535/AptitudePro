<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capgemini Coding Review | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#08111f;color:#eaf2ff;font:15px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:980px;margin:30px auto;padding:18px}.panel,.problem{background:#101d30;border:1px solid #293b54;border-radius:14px;padding:20px;margin-bottom:16px}h1,h2{color:white}.muted{color:#9aabc0}.status{color:#7fdcff;font-weight:700}.stats{display:flex;gap:22px;flex-wrap:wrap}pre{white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:auto;background:#08111e;border-radius:8px;padding:14px;font:13px/1.6 ui-monospace,Consolas,monospace}.btn{display:inline-block;margin:6px 8px 0 0;padding:10px 15px;border-radius:8px;background:#35b8e9;color:#06121d;text-decoration:none;font-weight:700}</style></head><body><main class="wrap"><section class="panel"><h1>Capgemini Coding Practice Review</h1><div class="stats"><span><strong><%= submission.executionAvailable ? `${submission.solvedProblems}/${submission.totalProblems}` : 'Not evaluated' %></strong> problems accepted</span><span><strong><%= submission.executionAvailable ? `${submission.score}%` : '—' %></strong> test score</span><span class="status"><%= submission.executionAvailable ? 'Executed in isolated sandbox' : 'Code saved; execution unavailable' %></span></div><p class="muted"><%= submission.evaluationNote %></p></section><% submission.problems.forEach((problem,index)=>{ %><section class="problem"><h2>Problem <%= index+1 %>: <%= problem.problemTitle %></h2><p class="status"><%= submission.executionAvailable ? problem.evaluationStatus : 'Not executed' %> · <%= problem.language || 'Language not selected' %> · <%= problem.passedTests %>/<%= problem.totalTests %> tests passed</p><% if(problem.attempted){ %><pre><%= problem.code %></pre><% }else{ %><p class="muted">No code was submitted for this problem.</p><% } %></section><% }) %><a class="btn" href="/placement/college/company/capgemini">Back to Capgemini practice</a><a class="btn" href="/capgemini/history">Practice history</a></main></body></html>
