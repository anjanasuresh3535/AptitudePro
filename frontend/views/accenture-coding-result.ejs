<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Accenture Coding Result | AptitudePro</title><style>body{margin:0;background:#08111f;color:#eaf2ff;font:15px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:980px;margin:30px auto;padding:18px}.panel,.problem{background:#101d30;border:1px solid #293b54;border-radius:14px;padding:20px;margin-bottom:16px}h1,h2{color:white}.muted{color:#9aabc0}.stat{display:flex;gap:22px;flex-wrap:wrap}.status{color:#7fdcff;font-weight:700}pre{white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:auto;background:#08111e;border-radius:8px;padding:14px;font:13px/1.6 ui-monospace,Consolas,monospace}.btn{display:inline-block;margin-right:8px;padding:10px 15px;border-radius:8px;background:#35b8e9;color:#06121d;text-decoration:none;font-weight:700}</style></head><body><main class="wrap"><section class="panel"><h1>Accenture Coding Result</h1><div class="stat"><span><strong><%= submission.executionAvailable ? submission.solvedProblems : '—' %></strong> problems accepted</span><span><strong><%= submission.executionAvailable ? `${submission.score}%` : 'Not evaluated' %></strong></span><span><strong>+<%= submission.xpEarned %></strong> XP</span><span class="status"><%= submission.executionAvailable ? 'Code evaluated' : 'Execution unavailable' %></span></div><p class="muted"><%= submission.evaluationNote %></p></section><% problems.forEach((problem,i)=>{ %><section class="problem"><h2>Problem <%= i+1 %>: <%= problem.title %></h2><p class="status"><%= problem.status %> · <%= problem.language || 'Language not selected' %></p><% if (problem.attempted) { %><pre><%= problem.code %></pre><% } else { %><p class="muted">No code was submitted for this problem.</p><% } %></section><% }) %><a class="btn" href="/results/<%= submission.resultId %>">Open full result</a><a class="btn" href="/results/history">Practice history</a><a class="btn" href="/placement/college/company/accenture">Accenture dashboard</a></main></body></html>
