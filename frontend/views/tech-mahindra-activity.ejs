<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · AptitudePro</title><link rel="stylesheet" href="/css/tech-mahindra.css"></head><body><header class="top"><a href="/placement/college/company/tech-mahindra">← Tech Mahindra practice</a><strong><%= title %></strong><span class="timer" id="timer" data-seconds="<%= remainingSeconds %>"></span></header><main class="wrap"><section class="card"><h1><%= title %></h1><p class="muted">AptitudePro practice activity. This is not an official or validated assessment; hiring formats may vary.</p>
<% if (kind === 'essay') { %><p class="notice">One original practice topic · <%= config.minutes %> minutes · Recommended length <%= config.minWords %>–<%= config.recommendedMaxWords %> words. Drafts autosave. Shorter or longer writing is preserved and can still be submitted.</p><% } %>
<% if (kind === 'psychometric') { %><p class="notice">72 workplace reflection statements · 20 minutes. Use the five-point agreement scale. Responses are saved for reflection only and are not scored, diagnosed, or used to predict hiring outcomes.</p><% } %>
<% if (kind === 'communication') { %><p class="notice">18 activities · 20 minutes. No Tech Mahindra audio assets or speech-evaluation service are configured, so listening tasks use a clearly labeled text practice alternative. Typed responses and optional local recordings are saved for self-review and are not automatically graded, uploaded, or evaluated.</p><% } %>
<% if (kind === 'technicalInterview' || kind === 'hrInterview') { %><p class="notice">Suggested answers are examples for study, not official answers. Draft your own response first, then reveal the guidance. No subjective answer is automatically graded.</p><% } %>
<form id="activityForm"><input type="hidden" id="attemptId" value="<%= attemptId %>">
<% if (kind === 'essay') { const saved = Object.fromEntries((savedResponses || []).map(r => [r.promptId,r.response])); const checkedReview=(saved['self-review']||'').split('; '); items.forEach((item,index) => { %><article class="item"><h2>Topic: <%= item.title %></h2><p><%= item.prompt %></p><label for="essay-<%= item.id %>">Your essay</label><textarea class="response essay" id="essay-<%= item.id %>" data-id="<%= item.id %>" maxlength="20000"><%= saved[item.id] || '' %></textarea><p class="muted"><span class="wordcount">0</span> words · Recommended minimum <%= config.minWords %></p></article><% }); %><div class="checklist"><h2>Self-review before submitting</h2><% ['Relevance to the topic','Clear organization and paragraph flow','Grammar and sentence clarity','Specific supporting points','A concise conclusion'].forEach(x=>{ %><label><input type="checkbox" class="self-review" value="<%= x %>" <%= checkedReview.includes(x)?'checked':'' %>> <%= x %></label><% }); %></div>
<% } else if (kind === 'psychometric') { const scale=['Strongly disagree','Disagree','Neither agree nor disagree','Agree','Strongly agree'],saved=Object.fromEntries((savedResponses||[]).map(r=>[r.promptId,r.response])); items.forEach(item=>{ %><article class="item"><h2><%= item.prompt %></h2><div class="scale"><% scale.forEach((label,i)=>{ %><label><input type="radio" name="<%= item.id %>" value="<%= label %>" <%= saved[item.id]===label?'checked':'' %>> <%= label %></label><% }); %></div></article><% }); %>
<% } else if (kind === 'communication') { const saved=Object.fromEntries((savedResponses||[]).map(r=>[r.promptId,r.response])); items.forEach(item=>{ %><article class="item"><h2><%= item.title %></h2><p><%= item.prompt %></p><% if(item.type==='reading-listening'){ %><p class="muted">Text-based accessible practice alternative (not an audio listening test):</p><div class="prompt"><%= item.text %></div><% } else if(item.type==='read-aloud' || item.type==='repeat'){ %><div class="prompt"><%= item.text %></div><% } else if(item.type==='retell'){ %><div class="prompt"><%= item.text %></div><% } else { %><div class="prompt"><%= item.text %></div><% } %><% if(item.type==='read-aloud' || item.type==='repeat'){ %><button class="btn secondary record" type="button">Start local recording</button> <button class="btn secondary stop-record" type="button" disabled>Stop recording</button><audio controls class="recording" hidden></audio><p class="muted record-status" aria-live="polite">Recording is not uploaded or automatically evaluated.</p><% } %><label for="response-<%= item.id %>">Your response</label><textarea class="response" id="response-<%= item.id %>" data-id="<%= item.id %>" maxlength="20000" placeholder="Type your answer or self-review notes"><%= saved[item.id]||'' %></textarea></article><% }); %>
<% } else { const saved=Object.fromEntries((savedResponses||[]).map(r=>[r.promptId,r.response])); items.forEach(item=>{ %><article class="item"><p class="muted"><%= item.category %></p><h2><%= item.question || item.prompt %></h2><label for="response-<%= item.id %>">Your answer</label><textarea class="response" id="response-<%= item.id %>" data-id="<%= item.id %>" maxlength="20000" placeholder="Draft your response"><%= saved[item.id]||'' %></textarea><button class="btn secondary reveal" type="button">Reveal suggested answer</button><div class="answer"><%= item.answer || item.example %></div></article><% }); if(kind==='hrInterview'){ const review=(saved['self-review']||'').split('; '); %><div class="checklist"><h2>Review your answer</h2><% ['Relevant to the question','Clear and concise','Supported by a real example','Professional tone','Accurate to my experience'].forEach(x=>{ %><label><input type="checkbox" class="self-review" value="<%= x %>" <%= review.includes(x)?'checked':'' %>> <%= x %></label><% }); %></div><% } } %>
<div class="actions"><button class="btn secondary" id="save" type="button">Save draft</button><button class="btn" id="submit" type="button">Finish and save for review</button></div><div class="status" id="status" role="status" aria-live="polite"></div></form></section></main>
<script nonce="<%= cspNonce %>">
(()=>{const kind=<%- JSON.stringify(kind) %>,attempt=document.getElementById('attemptId').value,status=document.getElementById('status'),all=()=>{const r={};document.querySelectorAll('.response').forEach(x=>r[x.dataset.id]=x.value);document.querySelectorAll('.scale input:checked').forEach(x=>r[x.name]=x.value);if(['essay','hrInterview'].includes(kind))r.__selfReview=[...document.querySelectorAll('.self-review:checked')].map(x=>x.value);return r};let pending,saving=false,submitAfterSave=false;const save=async submit=>{if(saving){if(submit)submitAfterSave=true;return}clearTimeout(pending);if(submit&&kind==='essay'){const text=document.querySelector('.essay')?.value.trim()||'',words=text?text.split(/\s+/).length:0;if(words<<%= config.minWords || 0 %> && !confirm('Your essay is below the recommended word count. Your writing will be kept. Submit it anyway?'))return;}saving=true;status.textContent=submit?'Saving…':'Saving draft…';try{const res=await fetch('/tech-mahindra/activity/'+kind+'/'+(submit?'submit':'draft'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId:attempt,responses:all()})}),body=await res.json();if(!res.ok||!body.ok)throw Error(body.message||'Could not save');if(submit)location.href=body.redirect;else status.textContent='Draft saved';}catch(e){status.textContent=e.message}finally{saving=false;if(submitAfterSave){submitAfterSave=false;save(true)}}};document.getElementById('save').onclick=()=>save(false);document.getElementById('submit').onclick=()=>save(true);document.querySelectorAll('.response,.scale input,.self-review').forEach(x=>x.addEventListener('input',()=>{if(kind==='essay')updateWords();clearTimeout(pending);pending=setTimeout(()=>save(false),900)}));document.querySelectorAll('.self-review').forEach(x=>x.addEventListener('change',()=>{clearTimeout(pending);pending=setTimeout(()=>save(false),200)}));function updateWords(){document.querySelectorAll('.essay').forEach(x=>{const n=x.value.trim()?x.value.trim().split(/\s+/).length:0;x.parentElement.querySelector('.wordcount').textContent=n})}updateWords();document.querySelectorAll('.reveal').forEach(b=>b.onclick=()=>{const a=b.nextElementSibling;a.classList.toggle('visible');b.textContent=a.classList.contains('visible')?'Hide suggested answer':'Reveal suggested answer'});let recorder,stream,chunks=[];document.querySelectorAll('.record').forEach(button=>button.onclick=async()=>{const card=button.closest('.item'),stop=card.querySelector('.stop-record'),audio=card.querySelector('.recording'),msg=card.querySelector('.record-status');try{if(!window.MediaRecorder||!navigator.mediaDevices?.getUserMedia)throw Error('Audio recording is not supported in this browser. You can type your response instead.');stream=await navigator.mediaDevices.getUserMedia({audio:true});recorder=new MediaRecorder(stream);chunks=[];recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};recorder.onstop=()=>{audio.src=URL.createObjectURL(new Blob(chunks,{type:recorder.mimeType||'audio/webm'}));audio.hidden=false;stream.getTracks().forEach(t=>t.stop());msg.textContent='Local recording ready for playback in this tab; it is not uploaded or graded.'};recorder.start();button.disabled=true;stop.disabled=false;msg.textContent='Recording…'}catch(e){msg.textContent=e.message}});document.querySelectorAll('.stop-record').forEach(b=>b.onclick=()=>{if(recorder?.state==='recording')recorder.stop();b.disabled=true;b.parentElement.querySelector('.record').disabled=false});if(+document.getElementById('timer').dataset.seconds>0){let s=+document.getElementById('timer').dataset.seconds;const t=document.getElementById('timer');t.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');const ticker=setInterval(()=>{s=Math.max(0,s-1);t.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');if(s===0){clearInterval(ticker);save(true)}},1000)}else document.getElementById('timer').textContent='Untimed practice';})();
</script></body></html>
