<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cognizant Coding | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>
*{box-sizing:border-box}body{margin:0;background:#08111f;color:#eaf2ff;font:15px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:1500px;margin:auto;padding:20px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center}.top a{color:#8fdcff}.timer{font-weight:800;color:#fbbf24}.grid{display:grid;grid-template-columns:minmax(300px,1fr) minmax(440px,1.05fr);gap:18px;margin-top:18px}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;min-width:0}.problem{white-space:pre-wrap}.meta{color:#a6b5c8}.nav,.actions{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.btn,select{border:0;border-radius:9px;padding:10px 14px;font-weight:700;background:#1da8d8;color:#08111f;cursor:pointer}.btn.secondary,select{background:#263851;color:#eaf2ff}.editor{width:100%;min-height:460px;background:#07101d;color:#eff6ff;border:1px solid #354963;border-radius:10px;padding:14px;font:14px/1.5 Consolas,monospace;resize:vertical}.output{white-space:pre-wrap;background:#07101d;padding:12px;border-radius:8px;min-height:40px}.status{color:#9edcff;min-height:28px}.sample{background:#07101d;padding:12px;border-radius:8px;white-space:pre-wrap}.empty{max-width:800px;margin:50px auto}.pill{color:#87d7ff}@media(max-width:850px){.grid{grid-template-columns:1fr}.editor{min-height:340px}}
</style></head><body><main class="wrap"><div class="top"><a href="/placement/college/company/cognizant">← Cognizant practice</a><span class="timer" id="timer" data-seconds="<%= remainingSeconds %>">--:--</span></div><% if (unavailable) { %><section class="panel empty"><h1>No coding problems available</h1><p><%= executionMessage %></p></section><% } else { %><div class="grid"><section class="panel"><div class="pill">Problem <span id="position">1</span> of <%= problems.length %></div><div class="nav"><button class="btn secondary" id="prev">Previous</button><button class="btn secondary" id="next">Next</button></div><h1 id="title"></h1><p class="meta" id="meta"></p><div id="statement" class="problem"></div><h3>Input</h3><div class="sample" id="inputFormat"></div><h3>Output</h3><div class="sample" id="outputFormat"></div><h3>Constraints</h3><div class="sample" id="constraints"></div><h3>Sample input</h3><pre class="sample" id="sampleInput"></pre><h3>Sample output</h3><pre class="sample" id="sampleOutput"></pre><details><summary>Approach explanation</summary><p id="explanation" class="problem"></p></details></section><section class="panel"><label for="language">Language </label><select id="language"></select><textarea class="editor" id="code" spellcheck="false" aria-label="Code editor"></textarea><div class="actions"><button class="btn secondary" id="save">Save draft</button><button class="btn secondary" id="reset">Reset current code</button><button class="btn" id="run">Run sample</button><button class="btn" id="submit">Submit assessment</button></div><p id="status" class="status" role="status"></p><p class="meta"><%= executionAvailable ? 'Code is evaluated in the hosted sandbox.' : (executionMessage || 'Execution unavailable. Drafts remain saveable; no output will be fabricated.') %></p><h3>Sample run</h3><pre id="output" class="output"></pre></section></div><script nonce="<%= cspNonce %>">
const problems=<%- JSON.stringify(problems).replace(/</g,'\\u003c') %>;const serverState=<%- initialStateJson %>;const attemptId='<%= attemptId %>';let index=0;let state=serverState.codeState||{};let selected=serverState.selectedLanguages||{};const title=document.getElementById('title'),meta=document.getElementById('meta'),statement=document.getElementById('statement'),lang=document.getElementById('language'),code=document.getElementById('code'),status=document.getElementById('status'),output=document.getElementById('output');function current(){return problems[index]}function key(){return current().id+'|'+lang.value}function render(){const p=current();document.getElementById('position').textContent=index+1;title.textContent=p.title;meta.textContent=p.topic+' · '+p.difficulty;statement.textContent=p.statement;for(const [id,value] of [['inputFormat',p.inputFormat],['outputFormat',p.outputFormat],['constraints',p.constraints],['sampleInput',p.sampleInput],['sampleOutput',p.sampleOutput],['explanation',p.explanation]])document.getElementById(id).textContent=value||'—';lang.replaceChildren(...p.languages.map(l=>{const o=document.createElement('option');o.value=l;o.textContent=l;return o}));lang.value=selected[p.id]||p.languages[0]||'';code.value=state[key()]??p.starters[lang.value]??'';output.textContent='';status.textContent=''}function saveLocal(){state[key()]=code.value;selected[current().id]=lang.value;localStorage.setItem('cog-code-'+attemptId,JSON.stringify({state,selected}))}function saveCloud(){saveLocal();return fetch('/cognizant/coding/draft',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId,questionId:current().id,language:lang.value,code:code.value})})}lang.addEventListener('change',()=>{saveLocal();render()});code.addEventListener('input',()=>{saveLocal()});document.getElementById('prev').onclick=()=>{saveLocal();index=(index+problems.length-1)%problems.length;render()};document.getElementById('next').onclick=()=>{saveLocal();index=(index+1)%problems.length;render()};document.getElementById('reset').onclick=async()=>{if(!confirm('Reset only this problem and language to its starter template?'))return;code.value=current().starters[lang.value]||'';saveLocal();await saveCloud();status.textContent='Current editor reset to its starter template.'};document.getElementById('save').onclick=async()=>{status.textContent='Saving draft…';try{const r=await saveCloud();const d=await r.json();status.textContent=r.ok&&d.ok?'Draft saved.':d.message||'Could not save draft.'}catch(_){status.textContent='Could not save draft.'}};document.getElementById('run').onclick=async()=>{status.textContent='Running sample tests…';output.textContent='';try{const r=await fetch('/cognizant/coding/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId,questionId:current().id,language:lang.value,code:code.value})});const d=await r.json();status.textContent=d.message||'Run complete.';output.textContent=(d.outputs||[]).map(x=>'Sample '+x.sample+':\n'+x.output).join('\n\n')||d.status||''}catch(_){status.textContent='Sample run failed.'}};document.getElementById('submit').onclick=async()=>{saveLocal();status.textContent='Submitting…';const submissions=problems.map(p=>({questionId:p.id,language:selected[p.id]||p.languages[0],code:state[p.id+'|'+(selected[p.id]||p.languages[0])]??p.starters[selected[p.id]||p.languages[0]]??''}));try{const r=await fetch('/cognizant/coding/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId,submissions})});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.message||'Submission failed.');location.href=d.redirect}catch(e){status.textContent=e.message}};const local=localStorage.getItem('cog-code-'+attemptId);if(local){try{const d=JSON.parse(local);state={...state,...(d.state||{})};selected={...selected,...(d.selected||{})}}catch(_){}}render();let seconds=Number(document.getElementById('timer').dataset.seconds)||0;function tick(){document.getElementById('timer').textContent=seconds<=0?'Time ended':String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');if(seconds>0)seconds--}tick();setInterval(tick,1000);
</script><% } %></main></body></html>
