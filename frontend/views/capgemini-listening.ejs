<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Listening Comprehension | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>
*{box-sizing:border-box}body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}.wrap{max-width:1000px;margin:auto;padding:22px}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;margin:14px 0}.muted{color:#9aabc0}.timer{color:#fbbf24;font-weight:800}.row{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.row h1{flex:1}.btn{display:inline-block;border:0;border-radius:9px;padding:11px 16px;background:#1da8d8;color:#08111f;font-weight:700;text-decoration:none;cursor:pointer}.passage{border-left:3px solid #1da8d8;padding-left:16px}.passage audio{width:min(100%,620px);display:block;margin:12px 0}.question{padding:12px 0;border-top:1px solid #253650}.choices label{display:flex;gap:9px;padding:7px 0}.status{color:#9edcff}button:disabled{opacity:.65;cursor:wait}
</style></head><body><main class="wrap"><a href="/placement/college/company/capgemini">← Capgemini practice</a><div class="row"><h1>Listening Comprehension</h1><strong id="timer" class="timer" data-seconds="<%= remainingSeconds %>">--:--</strong></div><p class="muted">Listen to each original practice passage and answer the questions. Audio uses a locally synthesized voice; it is not official Capgemini material. You can replay each clip during this session.</p>
<section class="panel"><strong id="progressText">0 of <%= totalQuestions %> answered</strong><progress id="progress" value="0" max="<%= totalQuestions %>" style="width:100%"></progress></section>
<% passages.forEach((passage,index)=>{ %><section class="panel passage"><h2>Passage <%= index+1 %>: <%= passage.title %></h2><audio controls preload="none" aria-label="Listen to <%= passage.title %> passage"><source src="<%= passage.audioUrl %>" type="audio/wav">Your browser does not support audio playback.</audio><p class="muted">Play the audio before answering. The written transcript is not shown during the assessment.</p><% passage.questions.forEach((question,qIndex)=>{ %><article class="question"><h3><%= qIndex+1 %>. <%= question.prompt %></h3><div class="choices" role="group" aria-label="Answer options for <%= question.prompt %>"><% Object.entries(question.options).forEach(([letter,text])=>{ %><label><input type="radio" name="<%= question.id %>" value="<%= letter %>"> <span><strong><%= letter %>.</strong> <%= text %></span></label><% }) %></div></article><% }) %></section><% }) %>
<div class="row"><button id="submit" class="btn">Finish and review</button><a class="btn" href="/capgemini/listening/restart">Start a different session</a></div><p id="status" class="status" role="status" aria-live="polite"></p>
<script nonce="<%= cspNonce %>">
const attemptId='<%= attemptId %>', totalQuestions=<%= totalQuestions %>;
const updateProgress=()=>{const count=document.querySelectorAll('input[type=radio]:checked').length;document.getElementById('progress').value=count;document.getElementById('progressText').textContent=`${count} of ${totalQuestions} answered`;};
document.querySelectorAll('input[type=radio]').forEach(input=>input.addEventListener('change',updateProgress));
let seconds=Number(document.getElementById('timer').dataset.seconds)||0;function tick(){document.getElementById('timer').textContent=seconds<=0?'Time ended':String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');if(seconds>0)seconds--;}tick();setInterval(tick,1000);
document.getElementById('submit').addEventListener('click',async()=>{const button=document.getElementById('submit'),status=document.getElementById('status');button.disabled=true;status.textContent='Saving your answers…';const answers={};document.querySelectorAll('input[type=radio]:checked').forEach(input=>answers[input.name]=input.value);try{const response=await fetch('/capgemini/listening/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attemptId,answers})});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.message||'Could not save results.');window.location.assign('/capgemini/result/'+encodeURIComponent(data.id));}catch(error){status.textContent=error.message;button.disabled=false;}});
</script></main></body></html>
