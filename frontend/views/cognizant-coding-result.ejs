<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Coding result | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.5 Inter,system-ui,sans-serif}.wrap{max-width:950px;margin:30px auto;padding:18px}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;margin:14px 0}a{color:#8fdcff}.meta{color:#9eafc5}.code{white-space:pre-wrap;overflow:auto;background:#07101d;padding:12px;border-radius:8px}</style></head><body><main class="wrap"><a href="/cognizant/history">← Cognizant history</a><h1>Cognizant coding result</h1><p class="meta"><%= submission.evaluationNote %></p><% submission.problems.forEach(p=>{ %><section class="panel"><h2><%= p.problemTitle %></h2><p><%= p.language %> · <%= safeStatus(p.evaluationStatus) %> · <%= p.passedTests %>/<%= p.totalTests %> tests passed</p><% if (p.explanation) { %><details><summary>Approach explanation</summary><p><%= p.explanation %></p></details><% } %><pre class="code"><%= p.code %></pre></section><% }) %></main></body></html>
