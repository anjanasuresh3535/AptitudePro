<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capgemini Practice History | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}main{max-width:950px;margin:30px auto;padding:18px}a{color:#8fdcff}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:18px;margin:14px 0}li{padding:8px 0;border-bottom:1px solid #253650}.muted{color:#9aabc0}</style></head><body><main><a href="/placement/college/company/capgemini">← Capgemini practice</a><h1>Capgemini practice history</h1><section class="panel"><h2>Objective assessments</h2><% if (!results.length) { %><p class="muted">No objective assessments submitted yet.</p><% } else { %><ul><% results.forEach(result=>{ %><li><a href="/results/<%= result._id %>"><%= result.testTitle || result.section %></a> — <%= result.correct %>/<%= result.totalQuestions %> · <%= result.accuracy %>% · <%= new Date(result.testDate).toLocaleString() %></li><% }) %></ul><% } %></section><section class="panel"><h2>Written, behavioral, games and listening sessions</h2><% if (!attempts.length) { %><p class="muted">No saved activity sessions yet.</p><% } else { %><ul><% attempts.forEach(attempt=>{ %><li><a href="/capgemini/result/<%= attempt._id %>"><%= attempt.sectionKey === 'games' ? 'Cognitive games' : attempt.sectionKey === 'writing' ? 'Business writing' : attempt.sectionKey === 'listening' ? 'Listening comprehension' : 'Behavioral competency' %> review</a> — <% if (attempt.score === null) { %>Not scored<% } else { %><%= attempt.score %>/<%= attempt.total %> activities correct<% } %> · <%= new Date(attempt.submittedAt || attempt.createdAt).toLocaleString() %></li><% }) %></ul><% } %></section><section class="panel"><h2>Coding submissions</h2><% if (!codingSubmissions.length) { %><p class="muted">No coding submissions. The Capgemini coding problem bank currently contains no active problems.</p><% } else { %><ul><% codingSubmissions.forEach(item=>{ %><li><%= item.solvedProblems %>/<%= item.totalProblems %> solved · <%= item.overallStatus %></li><% }) %></ul><% } %></section></main></body></html>
