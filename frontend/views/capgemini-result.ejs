<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Capgemini Practice Review | AptitudePro</title><link rel="stylesheet" href="/css/styles.css"><style>body{margin:0;background:#08111f;color:#eaf2ff;font:16px/1.55 Inter,system-ui,sans-serif}main{max-width:900px;margin:30px auto;padding:18px}a{color:#8fdcff}.panel{background:#101d30;border:1px solid #253650;border-radius:14px;padding:20px;margin:16px 0}.review{border-top:1px solid #253650;padding:14px 0}.muted{color:#9aabc0}.correct{color:#34d399}.incorrect{color:#fbbf24}audio{display:block;width:min(100%,620px);margin:12px 0}</style></head><body><main><a href="/capgemini/history">← Capgemini history</a><section class="panel"><h1><%= attempt.sectionKey === 'games' ? 'Cognitive games' : attempt.sectionKey === 'writing' ? 'Business writing' : attempt.sectionKey === 'listening' ? 'Listening comprehension' : 'Behavioral competency' %> review</h1><p class="muted"><%= attempt.status === 'submitted' ? 'Completed' : 'In progress' %> · <%= attempt.score === null ? 'Not scored' : `${attempt.score}/${attempt.total} correct` %> · <%= attempt.timeTaken %> seconds</p><% let lastPassage=''; attempt.responses.forEach(response=>{ %><article class="review"><% if (attempt.sectionKey === 'listening' && response.passageTitle !== lastPassage) { lastPassage=response.passageTitle; %><h2><%= response.passageTitle %></h2><audio controls preload="none" aria-label="Replay <%= response.passageTitle %>"><source src="<%= response.audioUrl %>" type="audio/wav"></audio><% } %><h3><%= response.prompt %></h3><% if (response.correct === null) { %><p><strong>Your response:</strong></p><p style="white-space:pre-wrap"><%= response.response || 'No response entered' %></p><% } else { %><p><strong>Result:</strong> <span class="<%= response.correct ? 'correct' : 'incorrect' %>"><%= response.correct ? 'Correct' : 'Review' %></span></p><p><strong>Your answer:</strong> <%= response.response || 'No answer entered' %></p><p><strong>Answer:</strong> <%= response.expectedAnswer %></p><% } %><p class="muted"><%= response.explanation %></p></article><% }) %></section><a href="/placement/college/company/capgemini">Return to Capgemini practice</a></main></body></html>
