<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard – AptitudePro</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Poppins',sans-serif; }
    body { display:flex; min-height:100vh; background:#0a1628; color:#e2e8f0; }
    .admin-sidebar { width:240px; min-height:100vh; background:rgba(15,23,42,0.95); border-right:1px solid rgba(255,255,255,0.08); position:fixed; top:0; left:0; bottom:0; display:flex; flex-direction:column; padding:0; z-index:100; }
    .admin-sidebar-logo { padding:20px 20px 16px; display:flex; align-items:center; gap:10px; font-size:16px; font-weight:800; color:#fff; border-bottom:1px solid rgba(255,255,255,0.08); }
    .admin-badge { background:#3b82f6; color:#fff; font-size:10px; font-weight:700; padding:2px 8px; border-radius:20px; margin-left:auto; }
    .admin-nav { flex:1; padding:16px 12px; display:flex; flex-direction:column; gap:4px; overflow-y:auto; }
    .admin-nav-link { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:10px; font-size:13px; font-weight:600; color:#94a3b8; text-decoration:none; transition:all 0.2s; }
    .admin-nav-link:hover { background:rgba(255,255,255,0.07); color:#fff; }
    .admin-nav-link.active { background:rgba(59,130,246,0.15); color:#60a5fa; border-left:3px solid #3b82f6; }
    .admin-sidebar-user { padding:16px 20px; border-top:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; gap:10px; }
    .admin-avatar { width:36px; height:36px; background:linear-gradient(135deg,#1a56db,#3b82f6); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; color:#fff; flex-shrink:0; }
    .admin-main { margin-left:240px; flex:1; padding:28px 32px; min-height:100vh; }
    .admin-topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
    .admin-topbar h1 { font-size:22px; font-weight:800; color:#fff; }
    .admin-topbar-right { display:flex; align-items:center; gap:12px; font-size:13px; color:#94a3b8; }
    .admin-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; margin-bottom:24px; }
    .admin-card { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:14px; padding:20px; }
    .admin-card-label { font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px; }
    .admin-card-value { font-size:28px; font-weight:800; color:#fff; }
    .admin-card-sub { font-size:12px; color:#64748b; margin-top:4px; }
    .admin-table-wrap { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden; margin-bottom:24px; }
    .admin-table-header { display:flex; justify-content:space-between; align-items:center; padding:16px 20px; border-bottom:1px solid rgba(255,255,255,0.08); }
    .admin-table-header h3 { font-size:15px; font-weight:700; color:#fff; }
    table { width:100%; border-collapse:collapse; }
    th { background:rgba(255,255,255,0.04); color:#94a3b8; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:12px 16px; text-align:left; }
    td { padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.05); color:#cbd5e1; font-size:13px; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:rgba(255,255,255,0.03); }
    .badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; }
    .badge-admin { background:rgba(59,130,246,0.15); color:#60a5fa; }
    .badge-user { background:rgba(148,163,184,0.12); color:#94a3b8; }
    .badge-active { background:rgba(34,197,94,0.15); color:#4ade80; }
    .badge-suspended { background:rgba(239,68,68,0.15); color:#f87171; }
    .flash-success { background:rgba(34,197,94,0.12); border:1px solid rgba(34,197,94,0.25); color:#4ade80; padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:13px; }
    .flash-error { background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.25); color:#f87171; padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:13px; }
    .empty-state { padding:48px 24px; text-align:center; color:#64748b; }
    .empty-state i { font-size:40px; margin-bottom:12px; display:block; }
    .empty-state p { font-size:14px; }
    .chart-wrap { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:20px; }
    .chart-wrap h3 { font-size:14px; font-weight:700; color:#fff; margin-bottom:16px; }
    .chart-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px; }
    .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .chart-empty { display:flex; align-items:center; justify-content:center; height:180px; color:#64748b; font-size:13px; }
    @media(max-width:768px){ .admin-sidebar{display:none;} .admin-main{margin-left:0;} .chart-grid,.grid2{grid-template-columns:1fr;} }
  </style>
</head>
<body>

<aside class="admin-sidebar">
  <div class="admin-sidebar-logo">
    <span>🧠</span> AptitudePro
    <div class="admin-badge">Admin</div>
  </div>
  <nav class="admin-nav">
    <a href="/admin" class="admin-nav-link active"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fas fa-users"></i> Users</a>
    <a href="/admin/questions" class="admin-nav-link"><i class="fas fa-question-circle"></i> Questions</a>
    <a href="/admin/results" class="admin-nav-link"><i class="fas fa-chart-bar"></i> Results</a>
    <a href="/admin/analytics" class="admin-nav-link"><i class="fas fa-chart-line"></i> Analytics</a>
    <a href="/admin/audit-log" class="admin-nav-link"><i class="fas fa-clipboard-list"></i> Audit Log</a>
    <hr style="border-color:rgba(255,255,255,0.1);margin:12px 0;">
    <a href="/dashboard?view=student" class="admin-nav-link"><i class="fas fa-arrow-left"></i> Student View</a>
    <a href="/logout" class="admin-nav-link" style="color:#f87171;"><i class="fas fa-sign-out-alt"></i> Logout</a>
  </nav>
  <div class="admin-sidebar-user">
    <div class="admin-avatar"><%= adminUser.name.charAt(0).toUpperCase() %></div>
    <div>
      <div style="font-size:13px;font-weight:600;color:#fff;"><%= adminUser.name %></div>
      <div style="font-size:11px;color:#60a5fa;">Administrator</div>
    </div>
  </div>
</aside>

<main class="admin-main">

  <div class="admin-topbar">
    <h1><i class="fas fa-tachometer-alt" style="color:#3b82f6;margin-right:8px;"></i>Dashboard Overview</h1>
    <div class="admin-topbar-right">
      <i class="fas fa-user-shield" style="color:#3b82f6;"></i>
      <span><%= adminUser.name %></span>
      <a href="/logout" style="color:#f87171;text-decoration:none;font-size:13px;"><i class="fas fa-sign-out-alt"></i></a>
    </div>
  </div>

  <% if (locals.flash) { %>
    <% if (locals.flash.success) { %>
      <div class="flash-success"><i class="fas fa-check-circle"></i> <%= locals.flash.success %></div>
    <% } %>
    <% if (locals.flash.error) { %>
      <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%= locals.flash.error %></div>
    <% } %>
  <% } %>

  <!-- Summary Cards -->
  <div class="admin-cards">
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-users" style="color:#3b82f6;margin-right:4px;"></i>Total Users</div>
      <div class="admin-card-value"><%= totalUsers %></div>
      <div class="admin-card-sub">Registered accounts</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-user-shield" style="color:#a78bfa;margin-right:4px;"></i>Admins</div>
      <div class="admin-card-value"><%= totalAdmins %></div>
      <div class="admin-card-sub">Admin accounts</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-question-circle" style="color:#fbbf24;margin-right:4px;"></i>Questions</div>
      <div class="admin-card-value"><%= totalQuestions %></div>
      <div class="admin-card-sub">In question bank</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-play-circle" style="color:#34d399;margin-right:4px;"></i>Quiz Attempts</div>
      <div class="admin-card-value"><%= totalAttempts %></div>
      <div class="admin-card-sub">All time</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-check-double" style="color:#4ade80;margin-right:4px;"></i>Completed</div>
      <div class="admin-card-value"><%= completedAttempts %></div>
      <div class="admin-card-sub">Finished quizzes</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-bullseye" style="color:#f97316;margin-right:4px;"></i>Avg Accuracy</div>
      <div class="admin-card-value"><%= avgAccuracy %>%</div>
      <div class="admin-card-sub">Overall performance</div>
    </div>
    <div class="admin-card">
      <div class="admin-card-label"><i class="fas fa-star" style="color:#fbbf24;margin-right:4px;"></i>Total XP</div>
      <div class="admin-card-value"><%= totalXP %></div>
      <div class="admin-card-sub">XP earned platform-wide</div>
    </div>
  </div>

  <!-- Charts Row 1 -->
  <div class="chart-grid">
    <div class="chart-wrap">
      <h3><i class="fas fa-user-plus" style="color:#3b82f6;margin-right:6px;"></i>User Registrations Over Time</h3>
      <% if (userTrend && userTrend.length > 0) { %>
        <canvas id="userTrendChart" height="180"></canvas>
      <% } else { %>
        <div class="chart-empty"><i class="fas fa-chart-line" style="margin-right:8px;"></i>No registration data yet</div>
      <% } %>
    </div>
    <div class="chart-wrap">
      <h3><i class="fas fa-chart-bar" style="color:#a78bfa;margin-right:6px;"></i>Quiz Attempts Over Time</h3>
      <% if (attemptTrend && attemptTrend.length > 0) { %>
        <canvas id="attemptTrendChart" height="180"></canvas>
      <% } else { %>
        <div class="chart-empty"><i class="fas fa-chart-bar" style="margin-right:8px;"></i>No attempt data yet</div>
      <% } %>
    </div>
  </div>

  <!-- Charts Row 2 -->
  <div class="chart-grid">
    <div class="chart-wrap">
      <h3><i class="fas fa-bullseye" style="color:#34d399;margin-right:6px;"></i>Accuracy by Section</h3>
      <% if (accuracyBySection && accuracyBySection.length > 0) { %>
        <canvas id="accuracySectionChart" height="220"></canvas>
      <% } else { %>
        <div class="chart-empty"><i class="fas fa-chart-bar" style="margin-right:8px;"></i>No accuracy data yet</div>
      <% } %>
    </div>
    <div class="chart-wrap">
      <h3><i class="fas fa-chart-pie" style="color:#fbbf24;margin-right:6px;"></i>Top Sections by Activity</h3>
      <% if (topSections && topSections.length > 0) { %>
        <canvas id="topSectionsChart" height="220"></canvas>
      <% } else { %>
        <div class="chart-empty"><i class="fas fa-chart-pie" style="margin-right:8px;"></i>No section data yet</div>
      <% } %>
    </div>
  </div>

  <!-- Tables Row -->
  <div class="grid2">

    <!-- Recent Users -->
    <div class="admin-table-wrap">
      <div class="admin-table-header">
        <h3><i class="fas fa-user-clock" style="color:#3b82f6;margin-right:6px;"></i>Recent Registrations</h3>
        <a href="/admin/users" style="font-size:12px;color:#60a5fa;text-decoration:none;">View all →</a>
      </div>
      <% if (recentUsers && recentUsers.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Joined</th>
            </tr>
          </thead>
          <tbody>
            <% recentUsers.forEach(function(u) { %>
              <tr>
                <td style="font-weight:600;color:#fff;"><%= u.name %></td>
                <td style="color:#94a3b8;"><%= u.email %></td>
                <td>
                  <span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= u.isActive ? 'badge-active' : 'badge-suspended' %>">
                    <%= u.isActive ? 'Active' : 'Suspended' %>
                  </span>
                </td>
                <td style="color:#64748b;"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-users"></i>
          <p>No users registered yet.</p>
        </div>
      <% } %>
    </div>

    <!-- Recent Attempts -->
    <div class="admin-table-wrap">
      <div class="admin-table-header">
        <h3><i class="fas fa-history" style="color:#a78bfa;margin-right:6px;"></i>Recent Quiz Attempts</h3>
        <a href="/admin/results" style="font-size:12px;color:#60a5fa;text-decoration:none;">View all →</a>
      </div>
      <% if (recentAttempts && recentAttempts.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Section</th>
              <th>Score</th>
              <th>Accuracy</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% recentAttempts.forEach(function(r) { %>
              <tr>
                <td style="font-weight:600;color:#fff;"><%= r.section %></td>
                <td><%= r.score %>/<%= r.totalQuestions %></td>
                <td>
                  <span class="badge" style="background:rgba(<%= r.accuracy >= 70 ? '34,197,94' : r.accuracy >= 40 ? '251,191,36' : '239,68,68' %>,0.15);color:<%= r.accuracy >= 70 ? '#4ade80' : r.accuracy >= 40 ? '#fbbf24' : '#f87171' %>;">
                    <%= r.accuracy %>%
                  </span>
                </td>
                <td style="color:#64748b;"><%= new Date(r.testDate).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-chart-bar"></i>
          <p>No quiz attempts recorded yet.</p>
        </div>
      <% } %>
    </div>

  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="<%= locals.cspNonce %>"></script>
<script nonce="<%= locals.cspNonce %>">
  Chart.defaults.color = '#94a3b8';
  Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

  var userTrendData = <%- JSON.stringify(userTrend || []) %>;
  var attemptTrendData = <%- JSON.stringify(attemptTrend || []) %>;
  var accuracyBySectionData = <%- JSON.stringify(accuracyBySection || []) %>;
  var topSectionsData = <%- JSON.stringify(topSections || []) %>;

  if (userTrendData.length > 0) {
    var ctx1 = document.getElementById('userTrendChart');
    if (ctx1) {
      new Chart(ctx1, {
        type: 'line',
        data: {
          labels: userTrendData.map(function(d) { return d._id || d.month || d.date || ''; }),
          datasets: [{
            label: 'New Users',
            data: userTrendData.map(function(d) { return d.count || 0; }),
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59,130,246,0.1)',
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#3b82f6',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
          }
        }
      });
    }
  }

  if (attemptTrendData.length > 0) {
    var ctx2 = document.getElementById('attemptTrendChart');
    if (ctx2) {
      new Chart(ctx2, {
        type: 'bar',
        data: {
          labels: attemptTrendData.map(function(d) { return d._id || d.month || d.date || ''; }),
          datasets: [{
            label: 'Attempts',
            data: attemptTrendData.map(function(d) { return d.count || 0; }),
            backgroundColor: 'rgba(167,139,250,0.6)',
            borderColor: '#a78bfa',
            borderWidth: 1,
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
          }
        }
      });
    }
  }

  if (accuracyBySectionData.length > 0) {
    var ctx3 = document.getElementById('accuracySectionChart');
    if (ctx3) {
      new Chart(ctx3, {
        type: 'bar',
        data: {
          labels: accuracyBySectionData.map(function(d) { return d._id || d.section || ''; }),
          datasets: [{
            label: 'Avg Accuracy (%)',
            data: accuracyBySectionData.map(function(d) { return Math.round(d.avgAccuracy || 0); }),
            backgroundColor: 'rgba(52,211,153,0.6)',
            borderColor: '#34d399',
            borderWidth: 1,
            borderRadius: 6
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.05)' }, max: 100 },
            y: { grid: { color: 'rgba(255,255,255,0.05)' } }
          }
        }
      });
    }
  }

  if (topSectionsData.length > 0) {
    var ctx4 = document.getElementById('topSectionsChart');
    if (ctx4) {
      var palette = ['#3b82f6','#a78bfa','#34d399','#fbbf24','#f97316','#f87171','#60a5fa','#818cf8'];
      new Chart(ctx4, {
        type: 'doughnut',
        data: {
          labels: topSectionsData.map(function(d) { return d._id || ''; }),
          datasets: [{
            data: topSectionsData.map(function(d) { return d.count || 0; }),
            backgroundColor: topSectionsData.map(function(d, i) { return palette[i % palette.length]; }),
            borderColor: '#0a1628',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: 'bottom', labels: { color: '#94a3b8', padding: 12, font: { size: 12 } } }
          }
        }
      });
    }
  }
</script>
</body>
</html>
