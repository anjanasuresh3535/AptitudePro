<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IBM Coding Assessment | AptitudePro</title><style>
:root{color-scheme:dark;--bg:#07101d;--panel:#101d30;--line:#293b54;--text:#edf5ff;--muted:#9aabc0;--blue:#35b8e9;--green:#34d399;--amber:#fbbf24}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 Inter,system-ui,sans-serif}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 22px;background:#0c1727;border-bottom:1px solid var(--line)}.brand{font-weight:800}.brand span{color:var(--blue)}.top a{color:#9ddfff;text-decoration:none}.timer{font-variant-numeric:tabular-nums;font-weight:800;color:#fff}.layout{max-width:1400px;margin:auto;padding:18px;display:grid;grid-template-columns:minmax(320px,.9fr) minmax(420px,1.1fr);gap:16px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden}.problem-tabs{display:flex;gap:8px;padding:12px;border-bottom:1px solid var(--line);overflow:auto}.tab{white-space:nowrap;border:1px solid var(--line);background:#0b1626;color:var(--text);padding:9px 13px;border-radius:8px;cursor:pointer}.tab.active{border-color:var(--blue);color:#7edaff}.problem{display:none;padding:20px}.problem.active{display:block}.problem h1{margin:5px 0 12px;font-size:1.35rem}.badge{color:#83dcff;font-size:.86rem}.spec{margin:20px 0 6px;font-weight:700}.block{white-space:pre-wrap;overflow-wrap:anywhere;background:#08111e;border:1px solid #1e3047;padding:12px;border-radius:8px;font-family:ui-monospace,Consolas,monospace;overflow-x:auto}.editor-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;border-bottom:1px solid var(--line)}select{background:#0b1626;color:var(--text);border:1px solid var(--line);padding:9px;border-radius:8px}textarea{display:block;width:100%;min-height:420px;resize:vertical;border:0;border-radius:0;background:#08111e;color:#eaf4ff;padding:16px;font:14px/1.6 ui-monospace,Consolas,monospace;tab-size:4;outline:none}.CodeMirror{height:420px;background:#08111e;font:14px/1.6 ui-monospace,Consolas,monospace}.CodeMirror-gutters{background:#0d1928;border-right:1px solid #263a52}.actions{display:flex;gap:10px;padding:12px;flex-wrap:wrap}.btn{border:0;border-radius:8px;padding:10px 15px;font-weight:700;cursor:pointer;background:var(--blue);color:#06121d}.btn.secondary{background:#243750;color:var(--text)}.btn.warning{background:#e6b84e;color:#161108}.result{padding:0 13px 14px;color:var(--muted);min-height:28px}.friendly{color:#b8cadc;padding:12px}.empty{max-width:800px;margin:50px auto;padding:24px;background:var(--panel);border-radius:14px}@media(max-width:850px){.layout{grid-template-columns:1fr;padding:12px}.top{padding:12px}.problem{padding:15px}.CodeMirror{height:340px}}@media(max-width:500px){.layout{padding:8px;gap:10px}.top{font-size:.9rem}.problem h1{font-size:1.15rem}.CodeMirror{height:300px}}
</style></head><body><header class="top"><div><a href="/placement/college/company/ibm">← IBM</a> <span class="brand">Aptitude<span>Pro</span> · Coding Assessment</span></div><strong>Problem <span id="problemPosition">1</span> / <%= problems.length %></strong><div class="timer" id="timer" data-seconds="<%= remainingSeconds %>">--:--</div></header>
<% if (unavailable) { %><main class="empty"><h1>No coding problems are available yet</h1><p>Try another IBM practice area or return later.</p><a href="/placement/college/company/ibm">Back to IBM practice</a></main><% } else { %><main class="layout"><section class="panel"><nav class="problem-tabs" id="tabs"><% problems.forEach((p,i)=>{ %><button class="tab <%= i===0?'active':'' %>" data-index="<%= i %>" type="button">Problem <%= i+1 %></button><% }) %></nav><% problems.forEach((p,i)=>{ %><article class="problem <%= i===0?'active':'' %>" data-problem="<%= i %>"><div class="badge"><%= p.topic %> · <%= p.difficulty %></div><h1><%= p.title %></h1><div><%= p.statement %></div><h2 class="spec">Input</h2><div class="block"><%= p.inputFormat %></div><h2 class="spec">Output</h2><div class="block"><%= p.outputFormat %></div><h2 class="spec">Constraints</h2><div class="block"><%= p.constraints %></div><h2 class="spec">Sample Input</h2><div class="block"><%= p.sampleInput %></div><h2 class="spec">Sample Output</h2><div class="block"><%= p.sampleOutput %></div><input type="hidden" class="qid" value="<%= p.id %>"></article><% }) %></section><section class="panel"><div class="editor-head"><label for="language">Language</label><select id="language"><% languages.forEach((lang,i)=>{ %><option value="<%= lang %>" <%= i===0?'selected':'' %>><%= lang %></option><% }) %></select><button id="loadStarter" class="btn secondary" type="button">Load Starter</button><button id="reset" class="btn secondary" type="button">Clear Code</button></div><% problems.forEach((p,i)=>{ %><textarea class="code" data-problem="<%= i %>" aria-label="Code for problem <%= i+1 %>" spellcheck="false" style="display:<%= i===0?'block':'none' %>"></textarea><% }) %><% if (executionBackend === 'judge0') { %><p class="friendly" style="padding-top:0">Code runs in a hosted Judge0 sandbox. Your source code and test inputs are sent to Judge0 for evaluation.</p><% } %><p class="friendly" id="draftStatus" role="status" aria-live="polite" style="padding-top:0">The editor starts blank. Load Starter inserts an optional template; saved drafts restore automatically and changes save as you work.</p><p class="friendly" id="executionNotice" <% if (executionAvailable) { %>hidden<% } %>><%= executionMessage || 'Code execution is unavailable. Your code will still be saved, but it cannot be evaluated until the secure execution service is available.' %></p><div class="actions"><button class="btn secondary" id="run" type="button">Run Code</button><button class="btn" id="submit" type="button">Submit Code</button></div><div class="result" id="result" role="status" aria-live="polite"></div></section></main>
<script nonce="<%= cspNonce %>">
const problems=<%- JSON.stringify(problems.map(p=>({id:p.id,title:p.title,languages:p.languages,starters:p.starters}))).replace(/</g,'\\u003c') %>;
const initial=<%- initialStateJson %>,attempt='<%= attemptId %>',lang=document.getElementById('language'),result=document.getElementById('result'),storeKey='aptitudepro-ibm-code-'+attempt;
let active=Math.max(0,Math.min(problems.length-1,Number(initial.currentProblem)||0)),loadedLanguage=initial.selectedLanguage||lang.options[0]?.value||'C',busy=false,expiredSubmitStarted=false,storage=null,saveQueue=Promise.resolve(),loadingEditor=false;const saveTimers=new Map();
try{storage=window.localStorage}catch(_){storage=null}
const drafts={codes:{...(initial.codeState||{})},languages:{...(initial.selectedLanguages||{})}};let local={};try{local=storage?JSON.parse(storage.getItem(storeKey)||'{}'):{}}catch(_){local={}}Object.assign(drafts.codes,local.codes||{});Object.assign(drafts.languages,local.languages||{});
function key(i,l){return problems[i].id+'|'+l}function persist(){try{if(storage)storage.setItem(storeKey,JSON.stringify(drafts))}catch(_){}}
const textareas=[...document.querySelectorAll('textarea.code')],cm=window.CodeMirror?textareas.map(area=>CodeMirror.fromTextArea(area,{lineNumbers:true,indentUnit:4,tabSize:4,indentWithTabs:false,autoCloseBrackets:true,theme:'material-darker',mode:'text/x-csrc'})):null;
function codeValue(i){return cm?cm[i].getValue():textareas[i].value}function setCode(i,value){if(cm)cm[i].setValue(value);else textareas[i].value=value}function setMode(i,language){if(cm)cm[i].setOption('mode',language==='Python'?'python':language==='C++'?'text/x-c++src':language==='Java'?'text/x-java':'text/x-csrc')}
function queueServerSave(){if(!problems.length)return;const i=active,l=loadedLanguage,k=key(i,l);clearTimeout(saveTimers.get(k));saveTimers.set(k,setTimeout(()=>saveToServer(i,l),350))}function saveToServer(i=active,l=loadedLanguage){if(!problems.length)return Promise.resolve();const code=i===active&&l===loadedLanguage?codeValue(i):(drafts.codes[key(i,l)]||'');drafts.codes[key(i,l)]=code;persist();const data={attemptId:attempt,questionId:problems[i].id,language:l,code};saveQueue=saveQueue.catch(()=>{}).then(()=>fetch('/ibm/coding/draft',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).catch(()=>null));return saveQueue}async function flushPendingSaves(){const pending=[];for(const[k,timerId]of saveTimers){clearTimeout(timerId);const split=k.lastIndexOf('|'),id=k.slice(0,split),language=k.slice(split+1),i=problems.findIndex(p=>p.id===id);if(i>=0)pending.push(saveToServer(i,language))}saveTimers.clear();pending.push(saveToServer());await Promise.all(pending)}
function saveCurrent(){if(loadingEditor)return;drafts.codes[key(active,loadedLanguage)]=codeValue(active);persist();queueServerSave()}
function setLanguages(i){const allowed=problems[i].languages;lang.replaceChildren(...allowed.map(value=>{const o=document.createElement('option');o.value=value;o.textContent=value;return o}))}
function loadCurrent(){loadingEditor=true;setLanguages(active);loadedLanguage=drafts.languages[active]||(active===initial.currentProblem?initial.selectedLanguage:null)||lang.options[0]?.value||'C';if(!problems[active].languages.includes(loadedLanguage))loadedLanguage=lang.options[0].value;lang.value=loadedLanguage;setMode(active,loadedLanguage);let saved=drafts.codes[key(active,loadedLanguage)];if(saved===problems[active].starters[loadedLanguage]){saved='';delete drafts.codes[key(active,loadedLanguage)]}setCode(active,saved??'');textareas.forEach((area,i)=>{if(cm){cm[i].getWrapperElement().style.display=i===active?'block':'none';if(i===active)cm[i].refresh()}else area.style.display=i===active?'block':'none'});document.getElementById('problemPosition').textContent=active+1;document.querySelectorAll('.tab').forEach((t,i)=>t.classList.toggle('active',i===active));document.querySelectorAll('.problem').forEach((p,i)=>p.classList.toggle('active',i===active));document.getElementById('draftStatus').textContent=saved?'Saved draft restored · changes save automatically.':'Blank editor · use Load Starter to insert an optional template.';result.textContent='';loadingEditor=false}
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',async()=>{if(busy)return;const oldIndex=active,oldLanguage=loadedLanguage;saveCurrent();const oldKey=key(oldIndex,oldLanguage);clearTimeout(saveTimers.get(oldKey));saveTimers.delete(oldKey);await saveToServer(oldIndex,oldLanguage);active=Number(t.dataset.index);drafts.languages[active]=drafts.languages[active]||oldLanguage;loadCurrent()}));
lang.addEventListener('change',async()=>{const next=lang.value,oldLanguage=loadedLanguage;saveCurrent();const oldKey=key(active,oldLanguage);clearTimeout(saveTimers.get(oldKey));saveTimers.delete(oldKey);await saveToServer(active,oldLanguage);loadedLanguage=next;drafts.languages[active]=loadedLanguage;loadCurrent()});if(cm)cm.forEach((editor,i)=>editor.on('change',()=>{if(i===active)saveCurrent()}));else textareas.forEach(a=>a.addEventListener('input',saveCurrent));
document.getElementById('loadStarter').addEventListener('click',()=>{setCode(active,problems[active].starters[lang.value]||'');saveCurrent()});document.getElementById('reset').addEventListener('click',()=>{setCode(active,'');saveCurrent()});
async function send(submit){if(busy)return;busy=true;const runButton=document.getElementById('run'),submitButton=document.getElementById('submit'),button=submit?submitButton:runButton,old=button.textContent;runButton.disabled=submitButton.disabled=true;button.textContent=submit?'Submitting…':'Running…';result.textContent=submit?'Saving your submission…':'Running sample tests…';await flushPendingSaves();const payload=submit?{attemptId:attempt,submissions:problems.map((p,i)=>{const selected=drafts.languages[i]||p.languages[0];return{questionId:p.id,language:selected,code:drafts.codes[key(i,selected)]??p.starters[selected]??''}})}:{attemptId:attempt,questionId:problems[active].id,language:loadedLanguage,code:codeValue(active)};try{const r=await fetch(submit?'/ibm/coding/submit':'/ibm/coding/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),body=await r.json();if(!r.ok||!body.ok)throw new Error(body.message||'Could not complete that action.');if(!submit&&body.status!=='not_executed')document.getElementById('executionNotice').hidden=true;if(submit){try{if(storage)storage.removeItem(storeKey)}catch(_){}location.href=body.redirect;return}const out=(body.outputs||[]).map((item,i)=>'Sample '+(item.sample||i+1)+':\n'+item.output).join('\n\n');result.textContent=(body.status||'Result')+' — '+body.message+(body.total?' ('+body.passed+'/'+body.total+' sample tests)':'')+(out?'\n\nOutput\n'+out:'')}catch(e){result.textContent=e.message}finally{busy=false;runButton.disabled=submitButton.disabled=false;button.textContent=old}}
document.getElementById('run').addEventListener('click',()=>send(false));document.getElementById('submit').addEventListener('click',()=>send(true));loadCurrent();
const timer=document.getElementById('timer');let remaining=Number(timer.dataset.seconds)||0;function tick(){timer.textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0');if(remaining<=0){if(!expiredSubmitStarted){expiredSubmitStarted=true;send(true)}return}remaining--}tick();setInterval(tick,1000);
</script><% } %></body></html>
