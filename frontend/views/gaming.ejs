<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0284c7;
            --primary-hover: #0369a1;
            --accent-cyan: #00f2fe;
            --accent-green: #00e676;
            --bg-dark: #090d16;
            --card-bg: rgba(15, 23, 42, 0.75);
            --card-border: rgba(255, 255, 255, 0.1);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-link {
            font-size: 22px;
            font-weight: 800;
            color: var(--accent-cyan);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-link {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: color 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff;
        }

        .gaming-container {
            max-width: 1140px;
            margin: 36px auto;
            padding: 0 24px;
            width: 100%;
            box-sizing: border-box;
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #fca5a5;
            padding: 14px 20px;
            border-radius: 12px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
        }

        /* HERO BANNER */
        .hero-banner {
            text-align: center;
            margin-bottom: 40px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.6) 100%);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px 24px;
            position: relative;
            overflow: hidden;
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.08) 0%, transparent 60%);
            pointer-events: none;
        }

        .hero-badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 242, 254, 0.12);
            border: 1px solid rgba(0, 242, 254, 0.3);
            color: var(--accent-cyan);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .hero-banner h1 {
            font-size: 38px;
            font-weight: 800;
            margin: 0 0 12px 0;
            background: linear-gradient(135deg, #ffffff 0%, #93c5fd 50%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }

        .hero-banner p {
            color: var(--text-muted);
            font-size: 16px;
            margin: 0 auto 24px auto;
            max-width: 680px;
            line-height: 1.6;
        }

        .hero-meta-strip {
            display: inline-flex;
            gap: 16px;
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
            color: #e2e8f0;
        }

        /* SECTION TITLES */
        .section-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .section-header h2 {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 8px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0;
        }

        /* HOW IT WORKS (4 STEPS) */
        .how-it-works-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
            margin-bottom: 44px;
        }

        .step-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 24px;
            position: relative;
            transition: transform 0.2s, border-color 0.2s;
        }

        .step-card:hover {
            transform: translateY(-3px);
            border-color: rgba(0, 242, 254, 0.3);
        }

        .step-number {
            font-size: 28px;
            font-weight: 800;
            color: var(--accent-cyan);
            margin-bottom: 12px;
            opacity: 0.9;
        }

        .step-card h3 {
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
            margin: 0 0 8px 0;
        }

        .step-card p {
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.5;
            margin: 0;
        }

        /* CURRENT LEVEL & MILESTONE CARDS */
        .user-status-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 44px;
        }

        @media (max-width: 768px) {
            .user-status-grid {
                grid-template-columns: 1fr;
            }
        }

        .status-card {
            background: var(--card-bg);
            border: 1.5px solid var(--card-border);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .status-card-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
        }

        .tier-icon-circle {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
        }

        .status-card-info h4 {
            margin: 0 0 4px 0;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }

        .status-card-info h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 800;
            color: #ffffff;
        }

        .xp-progress-wrapper {
            margin-bottom: 16px;
        }

        .xp-labels {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .progress-bar-bg {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 5px;
            overflow: hidden;
        }

        .progress-bar-active {
            height: 100%;
            border-radius: 5px;
            transition: width 0.5s ease;
        }

        /* YOUR GAMING JOURNEY (ROADMAP) */
        .roadmap-container {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 44px;
        }

        .tier-journey-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
            gap: 12px;
            margin-top: 24px;
        }

        .tier-journey-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1.5px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 14px 10px;
            text-align: center;
            position: relative;
            transition: all 0.25s;
        }

        .tier-journey-card.active-tier {
            background: rgba(15, 23, 42, 0.9);
            transform: scale(1.05);
            z-index: 2;
            box-shadow: 0 0 24px rgba(0, 0, 0, 0.6);
        }

        .tier-journey-card.completed-tier {
            background: rgba(15, 23, 42, 0.6);
            opacity: 0.85;
        }

        .tier-journey-card.future-tier {
            opacity: 0.5;
        }

        .tier-icon-small {
            font-size: 24px;
            margin-bottom: 6px;
        }

        .tier-name-small {
            font-size: 13px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 2px;
        }

        .tier-range-small {
            font-size: 10px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .tier-badge-indicator {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        /* GAME MODE CARDS */
        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
            gap: 24px;
            margin-bottom: 44px;
        }

        @media (max-width: 640px) {
            .games-grid {
                grid-template-columns: 1fr;
            }
        }

        .game-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 32px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
        }

        .game-card:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 255, 255, 0.25);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        .game-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .game-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .game-icon-wrapper {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .game-card h2 {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 10px 0;
        }

        .game-card p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            margin: 0 0 20px 0;
        }

        .game-stats-mini-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 24px;
            text-align: center;
        }

        .mini-stat-val {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
        }

        .mini-stat-lbl {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
        }

        .level-selector-box {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 24px;
        }

        .level-selector-box h4 {
            margin: 0 0 12px 0;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .level-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .level-radio-label, .difficulty-btn {
            background: rgba(30, 41, 59, 0.8);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 14px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 4px;
            transition: all 0.2s ease;
            user-select: none;
            position: relative;
            text-align: left;
            width: 100%;
            font-family: inherit;
            box-sizing: border-box;
        }

        .level-radio-label:hover, .difficulty-btn:hover {
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(51, 65, 85, 0.8);
        }

        .level-radio-label.selected, .difficulty-btn.selected {
            border-color: var(--accent-cyan);
            background: rgba(0, 242, 254, 0.15);
            box-shadow: 0 0 16px rgba(0, 242, 254, 0.25);
        }

        .game-card[style*="00e676"] .level-radio-label.selected,
        .game-card[style*="00e676"] .difficulty-btn.selected,
        .game-card[style*="00E676"] .difficulty-btn.selected {
            border-color: var(--accent-green);
            background: rgba(0, 230, 118, 0.15);
            box-shadow: 0 0 16px rgba(0, 230, 118, 0.25);
        }

        .level-radio-label input[type="radio"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .level-title {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .level-meta {
            font-size: 11px;
            color: var(--text-muted);
        }

        .btn-launch-game {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-size: 15px;
            font-weight: 800;
            cursor: pointer;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-launch-game:hover {
            filter: brightness(1.15);
            box-shadow: 0 8px 24px rgba(2, 132, 199, 0.4);
        }

        /* GAME STYLE COMPARISON & EXPLANATION CARDS */
        .comparison-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 44px;
        }

        @media (max-width: 768px) {
            .comparison-grid {
                grid-template-columns: 1fr;
            }
        }

        .comp-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 28px;
        }

        .comp-card h3 {
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 16px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .comp-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .comp-list li {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .comp-list li i {
            font-size: 12px;
            color: var(--accent-cyan);
        }

        .info-cards-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 44px;
        }

        @media (max-width: 768px) {
            .info-cards-row {
                grid-template-columns: 1fr;
            }
        }

        .info-box {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 24px;
        }

        .info-box h4 {
            margin: 0 0 10px 0;
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-box p {
            margin: 0;
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* EXPANDABLE 195-LEVEL ROADMAP (NATIVE HTML DISCLOSURE) */
        .expandable-map-box {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 28px;
            margin-bottom: 44px;
        }

        .roadmap-details {
            width: 100%;
        }

        .roadmap-summary {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #ffffff;
            padding: 16px 24px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background 0.2s, border-color 0.2s;
            list-style: none;
            user-select: none;
        }

        .roadmap-summary::-webkit-details-marker,
        .roadmap-summary::marker {
            display: none;
            content: "";
        }

        .roadmap-summary:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(0, 242, 254, 0.4);
        }

        .roadmap-details[open] .roadmap-summary {
            background: rgba(0, 242, 254, 0.1);
            border-color: var(--accent-cyan);
            border-radius: 14px 14px 0 0;
        }

        .roadmap-details[open] .summary-chevron {
            transform: rotate(180deg);
        }

        .summary-chevron {
            transition: transform 0.3s ease;
        }

        .roadmap-content {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--accent-cyan);
            border-top: none;
            border-radius: 0 0 14px 14px;
            padding: 24px;
            display: block;
        }

        .tier-accordion-group {
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 16px;
            background: rgba(15, 23, 42, 0.6);
        }

        .tier-accordion-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .tier-acc-title {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .level-chips-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .level-chip {
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(30, 41, 59, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            position: relative;
        }

        .level-chip.active-chip {
            border-color: var(--accent-cyan);
            background: rgba(0, 242, 254, 0.2);
            color: #ffffff;
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
        }

        .level-chip.completed-chip {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border-color: rgba(16, 185, 129, 0.3);
        }

        /* RECENT HISTORY TABLE */
        .recent-history-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 40px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .history-table th {
            text-align: left;
            padding: 12px 16px;
            color: var(--text-muted);
            font-weight: 700;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 12px;
            text-transform: uppercase;
        }

        .history-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #e2e8f0;
        }

        .history-table tr:last-child td {
            border-bottom: none;
        }

        .chip {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }

        .chip-speed { background: rgba(0, 242, 254, 0.15); color: #38bdf8; }
        .chip-accuracy { background: rgba(0, 230, 118, 0.15); color: #4ade80; }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/dashboard" class="brand-link">
            <i class="fa-solid fa-gamepad"></i> AptitudePro Gaming
        </a>
        <div class="nav-links">
            <button type="button" class="btn-nav-fullscreen" id="btnNavFullscreen" title="Toggle Full Screen (or press F)">
                <i class="fa-solid fa-expand"></i> <span>Full Screen</span>
            </button>
            <a href="/placement" class="nav-link"><i class="fa-solid fa-graduation-cap"></i> Practice</a>
            <a href="/gaming" class="nav-link active"><i class="fa-solid fa-gamepad"></i> Gaming</a>
            <a href="/dashboard" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
            <a href="/results/history" class="nav-link"><i class="fa-solid fa-clock-rotate-left"></i> History</a>
            <a href="/logout" class="nav-link"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </div>
    </nav>

    <div class="gaming-container">

        <% if (errorMsg) { %>
            <div class="alert-error">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span><%= errorMsg %></span>
            </div>
        <% } %>

        <!-- HERO BANNER -->
        <div class="hero-banner">
            <div class="hero-badge-pill">
                <i class="fa-solid fa-gamepad"></i> AptitudePro Gaming
            </div>
            <h1>PLAY SMART. PLAY FAST. LEVEL UP.</h1>
            <p>Turn aptitude practice into a competitive challenge where speed, accuracy and streaks help you climb from Nothing to GOAT.</p>
            
            <div class="hero-meta-strip">
                <span><i class="fa-solid fa-trophy" style="color: #facc15;"></i> 195 LEVELS</span>
                <span>•</span>
                <span><i class="fa-solid fa-layer-group" style="color: #38bdf8;"></i> 9 TIERS</span>
                <span>•</span>
                <span><i class="fa-solid fa-bolt" style="color: #4ade80;"></i> 2 GAME MODES</span>
            </div>
        </div>

        <!-- HOW APTITUDEPRO GAMING WORKS -->
        <div class="section-header">
            <h2><i class="fa-solid fa-circle-info" style="color: var(--accent-cyan);"></i> HOW APTITUDEPRO GAMING WORKS</h2>
            <p>Your 4-step competitive journey from fundamental practice to master tier rank.</p>
        </div>

        <div class="how-it-works-grid">
            <div class="step-card">
                <div class="step-number">01</div>
                <h3>CHOOSE YOUR GAME</h3>
                <p>Choose between Speed Challenge and Accuracy Rush, depending on whether you want to test speed or consistency.</p>
            </div>

            <div class="step-card">
                <div class="step-number">02</div>
                <h3>CHALLENGE YOURSELF</h3>
                <p>Select the available difficulty (Intermediate or Advanced) and solve aptitude questions under active game rules.</p>
            </div>

            <div class="step-card">
                <div class="step-number">03</div>
                <h3>EARN GAMING XP</h3>
                <p>Correct answers, successful streaks and game performance contribute directly to your Gaming XP.</p>
            </div>

            <div class="step-card">
                <div class="step-number">04</div>
                <h3>CLIMB THE LEVEL MAP</h3>
                <p>Gaming XP moves you through 195 levels across 9 tiers, from Nothing all the way to GOAT tier.</p>
            </div>
        </div>

        <!-- YOUR CURRENT LEVEL & NEXT MILESTONE CARDS -->
        <div class="user-status-grid">
            <!-- CURRENT LEVEL CARD -->
            <div class="status-card" style="border-color: <%= (tierColors[levelDetails.tier] || {}).border || 'rgba(255,255,255,0.15)' %>;">
                <div>
                    <div class="status-card-header">
                        <div class="tier-icon-circle" style="background: <%= (tierColors[levelDetails.tier] || {}).bg || 'rgba(255,255,255,0.1)' %>; border: 1px solid <%= (tierColors[levelDetails.tier] || {}).border || 'transparent' %>;">
                            <%= levelDetails.icon %>
                        </div>
                        <div class="status-card-info">
                            <h4 style="color: <%= (tierColors[levelDetails.tier] || {}).color || '#ffffff' %>;"><%= levelDetails.tier %> TIER</h4>
                            <h2><%= levelDetails.name %></h2>
                        </div>
                    </div>

                    <div class="xp-progress-wrapper">
                        <div class="xp-labels">
                            <span style="color: var(--text-muted);">Current XP Progress</span>
                            <span style="color: #ffffff;"><%= userXP.toLocaleString() %> / <%= levelDetails.max.toLocaleString() %> XP</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-active" style="width: <%= pctToNextLevel %>%; background: <%= (tierColors[levelDetails.tier] || {}).color || 'var(--accent-cyan)' %>;"></div>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.06); padding-top: 14px;">
                    <span><%= xpRemaining > 0 ? `${xpRemaining.toLocaleString()} XP to ${nextLevelDetails.name}` : 'Max Level Reached!' %></span>
                    <strong style="color: #facc15;"><%= userXP.toLocaleString() %> Gaming XP</strong>
                </div>
            </div>

            <!-- NEXT MILESTONE CARD -->
            <div class="status-card">
                <div>
                    <div class="status-card-header">
                        <div class="tier-icon-circle" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
                            <%= nextMilestoneTier.icon %>
                        </div>
                        <div class="status-card-info">
                            <h4 style="color: <%= nextMilestoneTier.color %>;">NEXT MILESTONE TIER</h4>
                            <h2><%= nextMilestoneTier.name %></h2>
                        </div>
                    </div>

                    <div class="xp-progress-wrapper">
                        <div class="xp-labels">
                            <span style="color: var(--text-muted);">Target: Level <%= nextMilestoneTier.targetLevel %></span>
                            <span style="color: <%= nextMilestoneTier.color %>;"><%= levelsToMilestone %> Levels Remaining</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-active" style="width: <%= Math.min(100, Math.round((userLevel / nextMilestoneTier.targetLevel) * 100)) %>%; background: <%= nextMilestoneTier.color %>;"></div>
                        </div>
                    </div>
                </div>

                <div style="font-size: 13px; color: var(--text-muted); border-top: 1px solid rgba(255,255,255,0.06); padding-top: 14px;">
                    <span>Milestone Level Range: <strong>Levels <%= nextMilestoneTier.range[0] %>–<%= nextMilestoneTier.range[1] %></strong></span>
                </div>
            </div>
        </div>

        <!-- YOUR GAMING JOURNEY (ROADMAP) -->
        <div class="roadmap-container">
            <div class="section-header" style="margin-bottom: 12px; text-align: left;">
                <h2><i class="fa-solid fa-map-location-dot" style="color: var(--accent-cyan);"></i> YOUR GAMING JOURNEY</h2>
                <p>195 levels. 9 tiers. One climb from Nothing to GOAT.</p>
            </div>

            <div class="tier-journey-row">
                <% allTiers.forEach((t, idx) => { 
                    const colors = tierColors[t.name] || {};
                    const isCurrent = t.name.toLowerCase() === levelDetails.tier.toLowerCase();
                    const isCompleted = currentTierIndex > idx;
                    const isFuture = !isCurrent && !isCompleted;
                %>
                    <div class="tier-journey-card <%= isCurrent ? 'active-tier' : (isCompleted ? 'completed-tier' : 'future-tier') %>"
                         style="border-color: <%= isCurrent ? colors.color : (isCompleted ? colors.border : 'rgba(255,255,255,0.08)') %>;">
                        
                        <% if (isCurrent) { %>
                            <span class="tier-badge-indicator" style="background: <%= colors.color %>; color: #090d16;">CURRENT TIER</span>
                        <% } else if (isCompleted) { %>
                            <span class="tier-badge-indicator" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);">✓ DONE</span>
                        <% } %>

                        <div class="tier-icon-small"><%= t.icon %></div>
                        <div class="tier-name-small" style="color: <%= colors.color || '#ffffff' %>;"><%= t.name %></div>
                        <div class="tier-range-small">Lv <%= t.levels %></div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- GAME SECTIONS SELECTION -->
        <div class="section-header">
            <h2><i class="fa-solid fa-gamepad" style="color: var(--accent-cyan);"></i> CHOOSE YOUR GAME</h2>
            <p>Select a game mode and your test difficulty to start playing.</p>
        </div>

        <div class="games-grid">
            
            <!-- GAME SECTION 1: SPEED CHALLENGE -->
            <form action="/gaming/session" method="POST" class="game-card" style="border-color: <%= gameSections.speedChallenge.borderColor %>;">
                <input type="hidden" name="gameSection" value="speedChallenge">
                <input type="hidden" name="difficulty" value="2">
                <div>
                    <div class="game-card-header">
                        <div class="game-icon-wrapper" style="background: rgba(0, 242, 254, 0.15); color: <%= gameSections.speedChallenge.color %>;">
                            <i class="fa-solid <%= gameSections.speedChallenge.icon %>"></i>
                        </div>
                        <span class="game-badge" style="background: rgba(0, 242, 254, 0.15); color: <%= gameSections.speedChallenge.color %>; border: 1px solid rgba(0, 242, 254, 0.3);">
                            <%= gameSections.speedChallenge.badge %>
                        </span>
                    </div>

                    <h2><%= gameSections.speedChallenge.name %></h2>
                    <p><%= gameSections.speedChallenge.description %></p>

                    <div class="game-stats-mini-row">
                        <div>
                            <div class="mini-stat-val" style="color: #38bdf8;"><%= gameStats.speedCount %></div>
                            <div class="mini-stat-lbl">Played</div>
                        </div>
                        <div>
                            <div class="mini-stat-val" style="color: #4ade80;"><%= gameStats.bestStreak %> 🔥</div>
                            <div class="mini-stat-lbl">Best Streak</div>
                        </div>
                        <div>
                            <div class="mini-stat-val" style="color: #facc15;">+<%= gameStats.totalXPEarned %></div>
                            <div class="mini-stat-lbl">Gaming XP</div>
                        </div>
                    </div>

                    <div class="level-selector-box">
                        <h4>Select Game Difficulty</h4>
                        <div class="level-options">
                            <button type="button" class="difficulty-btn selected" data-value="2" onclick="selectGameDifficulty(this, '2')">
                                <div class="level-title">
                                    <span>Intermediate</span>
                                    <i class="fa-solid fa-circle-check level-check-icon" style="color: var(--accent-cyan);"></i>
                                </div>
                                <div class="level-meta">15 Qs • 450s Timer</div>
                            </button>

                            <button type="button" class="difficulty-btn" data-value="3" onclick="selectGameDifficulty(this, '3')">
                                <div class="level-title">
                                    <span>Advanced</span>
                                    <i class="fa-solid fa-circle level-check-icon" style="color: var(--text-muted);"></i>
                                </div>
                                <div class="level-meta">20 Qs • 500s Timer</div>
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-launch-game" style="background: linear-gradient(135deg, #0284c7, #00f2fe); color: #090d16;">
                    <i class="fa-solid fa-play"></i> Play Speed Challenge
                </button>
            </form>

            <!-- GAME SECTION 2: ACCURACY RUSH -->
            <form action="/gaming/session" method="POST" class="game-card" style="border-color: <%= gameSections.accuracyRush.borderColor %>;">
                <input type="hidden" name="gameSection" value="accuracyRush">
                <input type="hidden" name="difficulty" value="2">
                <div>
                    <div class="game-card-header">
                        <div class="game-icon-wrapper" style="background: rgba(0, 230, 118, 0.15); color: <%= gameSections.accuracyRush.color %>;">
                            <i class="fa-solid <%= gameSections.accuracyRush.icon %>"></i>
                        </div>
                        <span class="game-badge" style="background: rgba(0, 230, 118, 0.15); color: <%= gameSections.accuracyRush.color %>; border: 1px solid rgba(0, 230, 118, 0.3);">
                            <%= gameSections.accuracyRush.badge %>
                        </span>
                    </div>

                    <h2><%= gameSections.accuracyRush.name %></h2>
                    <p><%= gameSections.accuracyRush.description %></p>

                    <div class="game-stats-mini-row">
                        <div>
                            <div class="mini-stat-val" style="color: #4ade80;"><%= gameStats.accuracyCount %></div>
                            <div class="mini-stat-lbl">Played</div>
                        </div>
                        <div>
                            <div class="mini-stat-val" style="color: #4ade80;"><%= gameStats.bestStreak %> 🔥</div>
                            <div class="mini-stat-lbl">Best Streak</div>
                        </div>
                        <div>
                            <div class="mini-stat-val" style="color: #facc15;">+<%= gameStats.totalXPEarned %></div>
                            <div class="mini-stat-lbl">Gaming XP</div>
                        </div>
                    </div>

                    <div class="level-selector-box">
                        <h4>Select Game Difficulty</h4>
                        <div class="level-options">
                            <button type="button" class="difficulty-btn selected" data-value="2" onclick="selectGameDifficulty(this, '2')">
                                <div class="level-title">
                                    <span>Intermediate</span>
                                    <i class="fa-solid fa-circle-check level-check-icon" style="color: var(--accent-green);"></i>
                                </div>
                                <div class="level-meta">15 Qs • Streak Bonuses</div>
                            </button>

                            <button type="button" class="difficulty-btn" data-value="3" onclick="selectGameDifficulty(this, '3')">
                                <div class="level-title">
                                    <span>Advanced</span>
                                    <i class="fa-solid fa-circle level-check-icon" style="color: var(--text-muted);"></i>
                                </div>
                                <div class="level-meta">20 Qs • High Multipliers</div>
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-launch-game" style="background: linear-gradient(135deg, #059669, #00e676); color: #090d16;">
                    <i class="fa-solid fa-play"></i> Play Accuracy Rush
                </button>
            </form>

        </div>

        <!-- WHICH GAME FITS YOUR STYLE? -->
        <div class="section-header">
            <h2><i class="fa-solid fa-sliders" style="color: var(--accent-cyan);"></i> WHICH GAME FITS YOUR STYLE?</h2>
            <p>Understand the gameplay mechanics and pick the mode that targets your goals.</p>
        </div>

        <div class="comparison-grid">
            <div class="comp-card" style="border-color: rgba(0, 242, 254, 0.3);">
                <h3 style="color: var(--accent-cyan);"><i class="fa-solid fa-bolt"></i> ⚡ SPEED CHALLENGE</h3>
                <ul class="comp-list">
                    <li><i class="fa-solid fa-check"></i> Solve questions faster under time pressure</li>
                    <li><i class="fa-solid fa-check"></i> Develop rapid logical deduction and decision speed</li>
                    <li><i class="fa-solid fa-check"></i> Earn bonus XP for quick correct answers</li>
                    <li><i class="fa-solid fa-check"></i> Ideal for time-restricted placement section tests</li>
                </ul>
            </div>

            <div class="comp-card" style="border-color: rgba(0, 230, 118, 0.3);">
                <h3 style="color: var(--accent-green);"><i class="fa-solid fa-bullseye"></i> 🎯 ACCURACY RUSH</h3>
                <ul class="comp-list">
                    <li><i class="fa-solid fa-check"></i> Maintain precision and zero-mistake focus</li>
                    <li><i class="fa-solid fa-check"></i> Build consecutive correct-answer streaks</li>
                    <li><i class="fa-solid fa-check"></i> Unlock escalating streak multiplier rewards</li>
                    <li><i class="fa-solid fa-check"></i> Ideal for mastering complex problem-solving accuracy</li>
                </ul>
            </div>
        </div>

        <!-- STREAK SYSTEM & GAMING XP EXPLANATIONS -->
        <div class="info-cards-row">
            <div class="info-box">
                <h4><i class="fa-solid fa-fire" style="color: #ff9500;"></i> 🔥 STREAK SYSTEM</h4>
                <p>Answer consecutive questions correctly to build your streak. Higher streaks unlock stronger game-specific bonus rewards and boost your final net XP yield.</p>
            </div>

            <div class="info-box">
                <h4><i class="fa-solid fa-bolt" style="color: #facc15;"></i> ⚡ GAMING XP & LEVELING</h4>
                <p>Gaming XP represents your progress through the AptitudePro Gaming journey. Earn XP through completed games to advance through 195 levels and 9 tiers from Nothing to GOAT.</p>
            </div>
        </div>

        <!-- EXPANDABLE 195-LEVEL ROADMAP (NATIVE HTML DISCLOSURE) -->
        <div class="expandable-map-box">
            <details class="roadmap-details">
                <summary class="roadmap-summary">
                    <span><i class="fa-solid fa-sitemap" style="color: var(--accent-cyan);"></i> VIEW FULL 195-LEVEL ROADMAP MAP (ALL 9 TIERS)</span>
                    <i class="fa-solid fa-chevron-down summary-chevron"></i>
                </summary>

                <div class="roadmap-content">
                    <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 20px 0;">
                        Explore all 195 levels across 9 milestone rank tiers. Your active level is highlighted with <strong>YOU ARE HERE</strong>.
                    </p>

                    <% fullMapByTier.forEach(t => { %>
                        <div class="tier-accordion-group" style="border-color: <%= t.isCurrentTier ? t.colors.color : 'rgba(255,255,255,0.08)' %>;">
                            <div class="tier-accordion-head">
                                <div class="tier-acc-title">
                                    <span><%= t.icon %></span>
                                    <span style="color: <%= t.colors.color || '#ffffff' %>;"><%= t.name %> Tier</span>
                                    <span style="font-size: 12px; color: var(--text-muted); font-weight: 600;">(Levels <%= t.rangeStr %>)</span>
                                </div>
                                <% if (t.isCurrentTier) { %>
                                    <span class="chip" style="background: <%= t.colors.color %>; color: #090d16; font-weight: 800;">ACTIVE TIER</span>
                                <% } else if (t.isCompletedTier) { %>
                                    <span class="chip" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">✓ COMPLETED</span>
                                <% } %>
                            </div>

                            <div class="level-chips-grid">
                                <% t.subLevels.forEach(sub => { %>
                                    <div class="level-chip <%= sub.isCurrent ? 'active-chip' : (sub.isCompleted ? 'completed-chip' : '') %>"
                                         title="<%= sub.details.name %> (Min XP: <%= sub.details.min %>, Max XP: <%= sub.details.max %>)">
                                        Level <%= sub.level %>: <%= sub.details.name %>
                                        <% if (sub.isCurrent) { %>
                                            <strong style="color: var(--accent-cyan); display: block; font-size: 9px; margin-top: 2px;">YOU ARE HERE</strong>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </details>
        </div>

        <!-- RECENT GAMES HISTORY TABLE -->
        <div class="recent-history-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3 style="margin: 0; color: #ffffff; font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-clock-rotate-left"></i> Recent Game Sessions
                </h3>
                <a href="/gaming/history" class="nav-link" style="color: var(--accent-cyan);">View All History &rarr;</a>
            </div>

            <% if (recentGames && recentGames.length > 0) { %>
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Game Mode</th>
                            <th>Difficulty</th>
                            <th>Score</th>
                            <th>Accuracy</th>
                            <th>Best Streak</th>
                            <th>XP Earned</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentGames.forEach(g => { %>
                            <tr>
                                <td>
                                    <span class="chip <%= g.gameSection === 'speedChallenge' ? 'chip-speed' : 'chip-accuracy' %>">
                                        <%= g.gameSectionName %>
                                    </span>
                                </td>
                                <td><%= g.difficultyName %></td>
                                <td><strong><%= g.score %></strong> / <%= g.totalQuestions %></td>
                                <td><%= g.accuracy %>%</td>
                                <td><%= g.maxStreak %> 🔥</td>
                                <td><strong style="color: #facc15;">+<%= g.netXP %> XP</strong></td>
                                <td><%= new Date(g.completedAt || g.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <a href="/gaming/result/<%= g.sessionId %>" class="nav-link" style="color: #38bdf8; font-size: 13px;">View Result</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: var(--text-muted); text-align: center; margin: 20px 0;">No completed game sessions yet. Select a game mode above to start playing!</p>
            <% } %>
        </div>

    </div>

    <script nonce="<%= cspNonce %>">
        function selectGameDifficulty(btnElement, value) {
            const form = btnElement.closest('form');
            if (!form) return;

            const hiddenInput = form.querySelector('input[name="difficulty"]');
            if (hiddenInput) {
                hiddenInput.value = value;
            }

            const iconWrapper = form.querySelector('.game-icon-wrapper');
            const accentColor = iconWrapper ? (iconWrapper.style.color || 'var(--accent-cyan)') : 'var(--accent-cyan)';

            const allBtns = form.querySelectorAll('.difficulty-btn, .level-radio-label');
            allBtns.forEach(btn => {
                const icon = btn.querySelector('.level-check-icon');
                const radio = btn.querySelector('input[type="radio"]');

                if (btn === btnElement) {
                    btn.classList.add('selected');
                    if (radio) radio.checked = true;
                    if (icon) {
                        icon.className = 'fa-solid fa-circle-check level-check-icon';
                        icon.style.color = accentColor;
                    }
                } else {
                    btn.classList.remove('selected');
                    if (radio) radio.checked = false;
                    if (icon) {
                        icon.className = 'fa-solid fa-circle level-check-icon';
                        icon.style.color = 'var(--text-muted)';
                    }
                }
            });
        }

        window.selectGameDifficulty = selectGameDifficulty;

        function bindDifficultyButtons() {
            document.querySelectorAll('.difficulty-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const val = this.getAttribute('data-value') || '2';
                    selectGameDifficulty(this, val);
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindDifficultyButtons);
        } else {
            bindDifficultyButtons();
        }
    </script>
</body>
</html>
