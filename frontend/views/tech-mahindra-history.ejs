<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tech Mahindra History · AptitudePro</title><style>body{margin:0;background:#08101c;color:#edf5ff;font:16px/1.5 system-ui,sans-serif}.wrap{max-width:1000px;margin:30px auto;padding:16px}.card{background:#121e30;border:1px solid #2b3b52;border-radius:14px;padding:20px;margin:14px 0}a{color:#75d8ff}.muted{color:#a7bad1}</style></head><body><main class="wrap"><p><a href="/placement/college/company/tech-mahindra">← Tech Mahindra practice</a></p><h1>Tech Mahindra practice history</h1><section class="card"><h2>Objective assessments</h2><% if(!results.length){ %><p class="muted">No objective attempts yet.</p><% } results.forEach(r=>{ %><p><a href="/results/<%= r._id %>"><%= r.testTitle %></a> · <%= r.correctAnswers %>/<%= r.totalQuestions %> correct · <%= new Date(r.testDate).toLocaleString() %></p><% }); %></section><section class="card"><h2>Written and reflective practice</h2><% if(!attempts.length){ %><p class="muted">No saved activities yet.</p><% } attempts.forEach(a=>{ %><p><a href="/tech-mahindra/result/<%= a._id %>"><%= a.sectionKey %> review</a> · <%= new Date(a.submittedAt).toLocaleString() %></p><% }); %></section><section class="card"><h2>Coding practice</h2><% if(!codingSubmissions.length){ %><p class="muted">No coding submissions yet.</p><% } codingSubmissions.forEach(c=>{ %><p><a href="/tech-mahindra/coding/result/<%= c._id %>"><%= c.testTitle %></a> · <%= c.executionAvailable ? `${c.solvedProblems}/${c.totalProblems} accepted` : 'Saved without execution' %></p><% }); %></section></main></body></html>
