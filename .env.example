PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/aptitudepro
NODE_ENV=development
SESSION_SECRET=replace_with_your_own_random_secret
ACTIVE_RESULT_LIMIT=100
# Accenture hosted sandbox (source and test inputs are sent to Judge0)
ACCENTURE_CODING_BACKEND=judge0
# Cognizant hosted sandbox (mirrors Accenture; 'docker' to use local containers)
COGNIZANT_CODING_BACKEND=judge0
JUDGE0_BASE_URL=https://ce.judge0.com
# Optional for a private/authenticated Judge0 instance
# JUDGE0_AUTH_TOKEN=replace-with-your-token
JUDGE0_REQUEST_TIMEOUT_MS=15000
JUDGE0_MAX_CONCURRENT_CASES=4
